#Область ПрограммныйИнтерфейс

Функция ВерсияОбработки() Экспорт
	Возврат "20260608_11";
КонецФункции

Функция ЗагрузитьПакет(ТекстXML) Экспорт

	ПакетОбъектXDTO = ПрочитатьПакетXDTO(ТекстXML);

	Если ПакетОбъектXDTO.Свойства().Получить("Отпуска") <> Неопределено Тогда
		Возврат ЗагрузитьПакет_2020(ПакетОбъектXDTO);
	ИначеЕсли ПакетОбъектXDTO.Свойства().Получить("ОтпускаФСС") <> Неопределено Тогда
		Возврат ЗагрузитьПакет_2020_ФСС(ПакетОбъектXDTO);
	Иначе
		ВызватьИсключение "Пакет не для отпусков.";
	КонецЕсли;

КонецФункции

Функция СформироватьПакет(ВыгружаемыйОбъект) Экспорт
	
	ОтветственныйЗагрузка = Константы.омПользовательДляЗаполненияДокументов.Получить();  
	Если НЕ ЗначениеЗаполнено(ОтветственныйЗагрузка) Тогда
		СООБЩИТЬ("Не выбран пользователь для заполнения документов!");
		Возврат "";
	КонецЕсли;
	
	ОбъектСсылка = ВыгружаемыйОбъект.Ссылка;
	ОбъектСсылкаМетаданные = ОбъектСсылка.Метаданные();
	ВидДокумента = ОбъектСсылкаМетаданные.Имя; 
	ВидДокументаСиноним = СОКРЛП(ОбъектСсылкаМетаданные.Синоним); 
	Если ВидДокументаСиноним = "" Тогда
		ВидДокументаСиноним = ВидДокумента;
	КонецЕсли;
	
	//+ КАБ Куцеборский 07.12.22
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	омОчередьИзмененныхОбъектовПериферияСрезПоследних.омПользователь.Наименование КАК Пользователь
	|ИЗ
	|	РегистрСведений.омОчередьИзмененныхОбъектовПериферия.СрезПоследних(&ТекущаяДата, ) КАК омОчередьИзмененныхОбъектовПериферияСрезПоследних
	|ГДЕ
	|	омОчередьИзмененныхОбъектовПериферияСрезПоследних.омСсылка = &омСсылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	омОчередьИзмененныхОбъектовПериферияСрезПоследних.Период УБЫВ";
	
	Запрос.УстановитьПараметр("омСсылка", ОбъектСсылка);
	Запрос.УстановитьПараметр("ТекущаяДата", КонецДня(ТекущаяДата()));
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	СлужебноеИзменение = Ложь;
	Если РезультатЗапроса.Следующий() Тогда
		Если РезультатЗапроса.Пользователь = "<Служебный пользователь 13>"  или РезультатЗапроса.Пользователь = "<Служебный пользователь 3>" Тогда
			СлужебноеИзменение = Истина;
		КонецЕсли;
	КонецЕсли;
	//-
	
	СтрокаЗапросаФизическоеЛицо = "
	|	"""" КАК Person, ";
	Если ВидДокумента = "Отпуск" Тогда
		СтрокаЗапросаФизическоеЛицо = "
		|	ПРЕДСТАВЛЕНИЕ(НужныйДокумент.ФизическоеЛицо) КАК Person, ";
	ИначеЕсли ВидДокумента = "ОтпускПоУходуЗаРебенком" Тогда
		СтрокаЗапросаФизическоеЛицо = "
		|	ПРЕДСТАВЛЕНИЕ(НужныйДокумент.Сотрудник) КАК Person, ";
	ИначеЕсли ВидДокумента = "ОтпускБезСохраненияОплаты" Тогда
		СтрокаЗапросаФизическоеЛицо = "
		|	ПРЕДСТАВЛЕНИЕ(НужныйДокумент.ФизическоеЛицо) КАК Person, ";
	ИначеЕсли ВидДокумента = "РаботаВВыходныеИПраздничныеДни" Тогда
		СтрокаЗапросаФизическоеЛицо = "
		|	"""" КАК Person, ";
	ИначеЕсли ВидДокумента = "ОплатаДнейУходаЗаДетьмиИнвалидами" Тогда
		СтрокаЗапросаФизическоеЛицо = "
		|	ПРЕДСТАВЛЕНИЕ(НужныйДокумент.ФизическоеЛицо) КАК Person, ";
	ИначеЕсли ВидДокумента = "ОплатаПоСреднемуЗаработку" Тогда
		СтрокаЗапросаФизическоеЛицо = "
		|	ПРЕДСТАВЛЕНИЕ(НужныйДокумент.ФизическоеЛицо) КАК Person, "; 
	ИначеЕсли ВидДокумента = "ВозвратИзОтпускаПоУходуЗаРебенком" Тогда
		СтрокаЗапросаФизическоеЛицо = "
		|	ПРЕДСТАВЛЕНИЕ(НужныйДокумент.Сотрудник) КАК Person, "; 
	КонецЕсли;
	
	//+ КАБ Куцеборский //приписка исправление в ДГУ
	Если НЕ ВидДокумента = "РаботаВВыходныеИПраздничныеДни" Тогда
		СтрокаИсправление = "
		|   ВЫБОР КОГДА НЕ НужныйДокумент.ИсправленныйДокумент = Значение(Документ."+ВидДокумента+".ПустаяСсылка) ТОГДА ""1"" ИНАЧЕ ""0"" КОНЕЦ КАК DocumentCorrection, ";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	НужныйДокумент.Ссылка КАК ОбъектСсылка,
	|	НужныйДокумент.Номер КАК DocumentNumber,
	|	НужныйДокумент.омУИД КАК DocumentUID,
	|	НужныйДокумент.Дата КАК DocumentDate,
	|	НужныйДокумент.Организация КАК ОрганизацияСсылка," + СтрокаИсправление + "
	|	НужныйДокумент.Организация.ИНН КАК OrganisationINN,
	|	НужныйДокумент.Организация.омУИД КАК OrganisationUID,
	|	НужныйДокумент.Организация.Наименование КАК OrganisationName,
	|	НужныйДокумент.Ответственный КАК ОтветственныйСсылка,
	|	ЕСТЬNULL(НужныйДокумент.Ответственный.Наименование, """") КАК AuthorName, " + СтрокаЗапросаФизическоеЛицо + "
	|	НужныйДокумент.Комментарий КАК Комментарий,
	|	НужныйДокумент.ПометкаУдаления КАК DocumentIsDeleted
	|ИЗ
	|	Документ." + ВидДокумента + " КАК НужныйДокумент
	|ГДЕ
	|	НужныйДокумент.Ссылка = &ОбъектСсылка
	|	И (НужныйДокумент.Ответственный = &ОтветственныйЗагрузка)
	|	";
	Запрос.УстановитьПараметр("ОбъектСсылка", ОбъектСсылка);
	Запрос.УстановитьПараметр("ОтветственныйЗагрузка", ОтветственныйЗагрузка);
	
	ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
	Если НЕ ВыборкаЗапроса.Следующий() Тогда
		Возврат "";
	КонецЕсли;
	
	СтрокаФизЛиц = "";
	Если ВидДокумента = "РаботаВВыходныеИПраздничныеДни" Тогда
		
		ЗапросФизЛиц = Новый Запрос;
		ЗапросФизЛиц.УстановитьПараметр("ОбъектСсылка", ОбъектСсылка);
		ЗапросФизЛиц.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РаботаВВыходныеИПраздничныеДниФизическиеЛица.ФизическоеЛицо КАК ФизическоеЛицо
		|ИЗ
		|	Документ.РаботаВВыходныеИПраздничныеДни.ФизическиеЛица КАК РаботаВВыходныеИПраздничныеДниФизическиеЛица
		|ГДЕ
		|	РаботаВВыходныеИПраздничныеДниФизическиеЛица.Ссылка = &ОбъектСсылка";
		ВыборкаФизЛиц = ЗапросФизЛиц.Выполнить().Выбрать();
		Пока ВыборкаФизЛиц.Следующий() Цикл
			СтрокаФизЛиц = СтрокаФизЛиц + ?(СтрокаФизЛиц = "", "", ",") + СТРОКА(ВыборкаФизЛиц.ФизическоеЛицо);
		КонецЦикла;
		
	КонецЕсли;
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку("UTF-8");
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("data");
	ЗаписьXML.ЗаписатьНачалоЭлемента("Organisation");
	ЗаписьXML.ЗаписатьАтрибут("OrganisationINN", ВыборкаЗапроса.OrganisationINN);
	Если СОКРЛП(ВыборкаЗапроса.OrganisationUID) = "" Тогда
		ЗаписьXML.ЗаписатьАтрибут("OrganisationUID", СТРОКА(ВыборкаЗапроса.ОрганизацияСсылка.УникальныйИдентификатор()));
	Иначе
		ЗаписьXML.ЗаписатьАтрибут("OrganisationUID", ВыборкаЗапроса.OrganisationUID);
	КонецЕсли;
	ЗаписьXML.ЗаписатьАтрибут("OrganisationName", ВыборкаЗапроса.OrganisationName);
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Documents");
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Document");
	ЗаписьXML.ЗаписатьАтрибут("DocumentType", ВидДокумента);
	ЗаписьXML.ЗаписатьАтрибут("DocumentTypeDescription", ВидДокументаСиноним);
	Если СОКРЛП(ВыборкаЗапроса.DocumentUID) = "" Тогда
		ЗаписьXML.ЗаписатьАтрибут("DocumentUID", СТРОКА(ВыборкаЗапроса.ОбъектСсылка.УникальныйИдентификатор()));
	Иначе
		ЗаписьXML.ЗаписатьАтрибут("DocumentUID", ВыборкаЗапроса.DocumentUID);
	КонецЕсли;
	ЗаписьXML.ЗаписатьАтрибут("DocumentNumber", ВыборкаЗапроса.DocumentNumber);
	ЗаписьXML.ЗаписатьАтрибут("AuthorName", ВыборкаЗапроса.AuthorName);
	Если СтрокаФизЛиц = "" Тогда
		ЗаписьXML.ЗаписатьАтрибут("Person", ВыборкаЗапроса.Person);
	Иначе
		Если СтрДлина(СтрокаФизЛиц) > 250 Тогда
			ЗаписьXML.ЗаписатьАтрибут("Person", ЛЕВ(СтрокаФизЛиц, 250));
		Иначе
			ЗаписьXML.ЗаписатьАтрибут("Person", СтрокаФизЛиц);
		КонецЕсли;
	КонецЕсли;
	ТекКомментарий = СОКРЛП(ВыборкаЗапроса.Комментарий);
	Если ТекКомментарий <> "" Тогда
		ПозицияНомерПриказа = СтрНайти(ТекКомментарий, "номер приказа");
		Если ПозицияНомерПриказа = 0 Тогда
			ПозицияНомерПриказа = СтрНайти(ТекКомментарий, "Номер приказа");
		КонецЕсли;
		Если ПозицияНомерПриказа > 0 Тогда
			ПозицияНачалоНомера = ПозицияНомерПриказа + 14;
			ПозицияОт = СтрНайти(ТекКомментарий, " от", НаправлениеПоиска.СНачала, ПозицияНомерПриказа);
			Если ПозицияОт = 0 Тогда
				КоличествоСимволовНомер = 15;
			Иначе
				КоличествоСимволовНомер = ПозицияОт - ПозицияНачалоНомера;
			КонецЕсли;
			ПозицияНачалоДаты = ПозицияОт + 4;
			СтрокаДатаПриказа = СОКРЛП(СРЕД(ТекКомментарий,ПозицияНачалоДаты,10));
			СтрокаДатаПриказа = СтрокаДатаПриказа + " 00:00:00";
			СтрокаНомерПриказа = СОКРЛП(СРЕД(ТекКомментарий, ПозицияНачалоНомера, КоличествоСимволовНомер));
			Если СтрокаДатаПриказа <> "" Тогда
				ЗаписьXML.ЗаписатьАтрибут("DocumentDate", XMLСтрока(ДАТА(СтрокаДатаПриказа)));
			КонецЕсли;
			Если СтрокаНомерПриказа <> "" Тогда
				ЗаписьXML.ЗаписатьАтрибут("OrderNumber", СтрокаНомерПриказа);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	ЗаписьXML.ЗаписатьАтрибут("DocumentIsDeleted", XMLСтрока(ВыборкаЗапроса.DocumentIsDeleted));
	
	//+
	Если НЕ ВидДокумента = "РаботаВВыходныеИПраздничныеДни" Тогда
		ЗаписьXML.ЗаписатьАтрибут("DocumentCorrection", ВыборкаЗапроса.DocumentCorrection);
	КонецЕсли;
	//-
	//+ КАБ Куцеборский 07.12.22
	Если СлужебноеИзменение Тогда
		ЗаписьXML.ЗаписатьАтрибут("ServiceUser", "1");
	Иначе
		ЗаписьXML.ЗаписатьАтрибут("ServiceUser", "0");
	КонецЕсли;
	//-
	//{[+](фрагмент добавлен), ООО КАБ Парамонов Д.Б. 2 ноября 2022 г.
	//dataBaseID = ИнтеграцияС1СДокументооборотПовтИсп.ИдентификаторБазыДанных();
	dataBaseID = ПланыОбмена.ИнтеграцияС1СДокументооборотомПереопределяемый.ЭтотУзел().Наименование;
	ЗаписьXML.ЗаписатьАтрибут("dataBaseID", XMLСтрока(dataBaseID));
	ЗаписьXML.ЗаписатьАтрибут("externalID", XMLСтрока(ВыборкаЗапроса.ОбъектСсылка.УникальныйИдентификатор()));
	ЗаписьXML.ЗаписатьАтрибут("externaltype", XMLСтрока(ВыборкаЗапроса.ОбъектСсылка.Метаданные().ПолноеИмя()));
	ЗаписьXML.ЗаписатьАтрибут("externalname", XMLСтрока(Строка(ВыборкаЗапроса.ОбъектСсылка)));
	//}Парамонов Д.Б. от 2 ноября 2022 г.
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Document
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Documents
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Organisation
	ЗаписьXML.ЗаписатьКонецЭлемента(); // data
	
	СтрокаXML = ЗаписьXML.Закрыть();
	
	Возврат СтрокаXML;
	
КонецФункции

//+ КАБ Куцеборский 23.12.22

#КонецОбласти

#Область РазборИГруппировкаПакета

Функция ПрочитатьПакетXDTO(ТекстXML)

	Если СокрЛП(ТекстXML) = "" Или СокрЛП(ТекстXML) = "Передан пустой пакет" Тогда
		ВызватьИсключение "Передан пустой пакет";
	КонецЕсли;

	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ТекстXML);
	ПакетФабрикаXDTO = Новый ФабрикаXDTO;
	Возврат ПакетФабрикаXDTO.ПрочитатьXML(ЧтениеXML);

КонецФункции

Функция РазрешитьОрганизациюПакета(ПакетОбъектXDTO)

	Если ПакетОбъектXDTO.Свойства().Получить("IDОрганизации") = Неопределено Тогда
		ВызватьИсключение "нет IDОрганизации в пакете";
	КонецЕсли;
	Если ПакетОбъектXDTO.Свойства().Получить("ИНН") = Неопределено Тогда
		ВызватьИсключение "нет ИНН организации в пакете";
	КонецЕсли;

	ОрганизацияУИД = СокрЛП(ПакетОбъектXDTO.IDОрганизации);
	ОрганизацияИНН = СокрЛП(ПакетОбъектXDTO.ИНН);
	Если ОрганизацияУИД = "" Или ОрганизацияИНН = "" Тогда
		ВызватьИсключение "В пакете пустой УИД или ИНН организации!";
	КонецЕсли;

	ОрганизацияСсылка = Справочники.Организации.НайтиПоРеквизиту("омУИД", ОрганизацияУИД);
	Если Не ЗначениеЗаполнено(ОрганизацияСсылка) Тогда
		ОрганизацияСсылка = Справочники.Организации.НайтиПоРеквизиту("ИНН", ОрганизацияИНН);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ОрганизацияСсылка) Тогда
		ВызватьИсключение "Не обнаружена организация по УИД=" + ОрганизацияУИД + " или ИНН=" + ОрганизацияИНН + " !";
	КонецЕсли;

	Возврат ОрганизацияСсылка;

КонецФункции

Функция ПолучитьМассивЭлементовОтпуска(ПакетОбъектXDTO)

	Если ТипЗнч(ПакетОбъектXDTO.Отпуска) = Тип("ОбъектXDTO") Тогда
		МассивОтпусков = Новый Массив;
		МассивОтпусков.Добавить(ПакетОбъектXDTO.Отпуска);
		Возврат МассивОтпусков;
	КонецЕсли;

	Возврат ПакетОбъектXDTO.Отпуска;

КонецФункции

Функция ПолучитьМассивСтрокОтпуска(ЭлементОтпуска)

	Если ЭлементОтпуска.Свойства().Получить("Отпуск") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(ЭлементОтпуска.Отпуск) = Тип("ОбъектXDTO") Тогда
		МассивСтрок = Новый Массив;
		МассивСтрок.Добавить(ЭлементОтпуска.Отпуск);
		Возврат МассивСтрок;
	КонецЕсли;

	Возврат ЭлементОтпуска.Отпуск;

КонецФункции

Функция СтрокаСвязанаСУвольнениемБезКомпенсаций(СтрокаXDTO)

	Если СтрокаXDTO.Свойства().Получить("СвязанСУвольнением") = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СокрЛП(СтрокаXDTO.СвязанСУвольнением) <> "1" Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат (СтрокаXDTO.КомпСанКур = "0" Или СтрокаXDTO.КомпСанКур = "")
		И (СтрокаXDTO.ПредоставитьМатериальнуюПомощьПриОтпуске = "0" Или СтрокаXDTO.ПредоставитьМатериальнуюПомощьПриОтпуске = "")
		И (СтрокаXDTO.ПредоставитьЕдиновременнуюВыплатуКОтпуску = "" Или СтрокаXDTO.ПредоставитьЕдиновременнуюВыплатуКОтпуску = "0");

КонецФункции

Функция ВычислитьИдентификаторДокумента(СтрокаXDTO, ЭтоОтгул)

	ПриказИД = СокрЛП(СтрокаXDTO.ID);
	СотрудникИД = СокрЛП(СтрокаXDTO.Сотрудник);
	ДокументИД = ПриказИД + "_" + СотрудникИД;
	ВидОтпускаИД = СокрЛП(СтрокаXDTO.ВидОтпуска);

	Если ВидОтпускаИД = "103566120" Или ВидОтпускаИД = "252826160" Или ВидОтпускаИД = "251001401" Тогда
		ДокументИД = ДокументИД + "_1";
	КонецЕсли;

	Если ВидОтпускаИД = "256880646" Или ВидОтпускаИД = "236498269" Тогда
		ДокументИД = ПриказИД;
	КонецЕсли;

	Если ЭтоОтгул Тогда
		ДокументИД = ДокументИД + "_" + Формат(ДатаИзСтрокиПакета(СтрокаXDTO.ДатаНачалаОсновногоОтпуска), "ДФ=dd.MM.yyyy");
	КонецЕсли;

	Возврат ДокументИД;

КонецФункции

Функция ОпределитьПризнакиВидаОтпуска(ВидОтпускаИД)

	СтруктураСопоставленныйОбъект = РегистрыСведений.омСопоставлениеОбъектов.ПолучитьЗаписатьОбъект(
		"Справочник.ВидыОтпусков", ВидОтпускаИД, "", Ложь, Ложь);
	ВидОтпускаНаименованиеПолное = СтруктураСопоставленныйОбъект.ОбъектВнешнееНаименование;
	ВидОтпускаНаименованиеПолное = СтрЗаменить(ВидОтпускаНаименованиеПолное, "   ", " ");
	ВидОтпускаНаименованиеПолное = СтрЗаменить(ВидОтпускаНаименованиеПолное, "  ", " ");

	ЭтоОплатаПоСреднемуЗаработку = (
		ВидОтпускаНаименованиеПолное = "дополнительные дни отдыха после сдачи крови"
		Или ВидОтпускаНаименованиеПолное = "Дополнительные дни отдыха после сдачи крови"
		Или ВидОтпускаНаименованиеПолное = "предоставлении дополнительных дней отдыха с сохранением денежного содержания для вакцинации против новой коронавирусной инфекции"
		Или ВидОтпускаНаименованиеПолное = "Предоставлении дополнительных дней отдыха с сохранением денежного содержания для вакцинации против новой коронавирусной инфекции"
		Или ВидОтпускаНаименованиеПолное = "Краткосрочный отпуск по коллективному договору");
	ЭтоОтгул = (
		ВидОтпускаНаименованиеПолное = "предоставить оплачиваемые нерабочие дни (отгул)"
		Или ВидОтпускаНаименованиеПолное = "предоставить дополнительный неоплачиваемый день отдыха"
		Или ВидОтпускаИД = "266514749");

	Возврат Новый Структура("ЭтоОплатаПоСреднемуЗаработку, ЭтоОтгул", ЭтоОплатаПоСреднемуЗаработку, ЭтоОтгул);

КонецФункции

Функция СтрокаПакетаПропускается(СтрокаXDTO, СоответствиеПропускаемыхВидовОтпусков, СоответствиеВидовОтпусковВозвратИзОУР)

	Если СтрокаСвязанаСУвольнениемБезКомпенсаций(СтрокаXDTO) Тогда
		Возврат Истина;
	КонецЕсли;

	ВидОтпускаИД = СокрЛП(СтрокаXDTO.ВидОтпуска);
	ДействиеДокумента = СокрЛП(СтрокаXDTO.Действие);

	Если СоответствиеВидовОтпусковВозвратИзОУР.Получить(ВидОтпускаИД) <> Неопределено И ДействиеДокумента = "Отозвать" Тогда
		Возврат Ложь;
	КонецЕсли;

	Если СоответствиеПропускаемыхВидовОтпусков.Получить(ВидОтпускаИД) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Процедура ДобавитьСтрокуВГруппуДокументов(СоответствиеДанныхДокументов, ДокументИД, СтрокаXDTO)

	МассивСтрокДанных = СоответствиеДанныхДокументов.Получить(ДокументИД);
	Если МассивСтрокДанных = Неопределено Тогда
		МассивСтрокДанных = Новый Массив;
		СоответствиеДанныхДокументов.Вставить(ДокументИД, МассивСтрокДанных);
	КонецЕсли;
	МассивСтрокДанных.Добавить(СтрокаXDTO);

КонецПроцедуры

Функция СгруппироватьСтрокиПакетаПоДокументам(ПакетОбъектXDTO)

	СоответствиеДанныхДокументов = Новый Соответствие;
	СоответствиеПропускаемыхВидовОтпусков = ПолучитьСоответствиеПропускаемыхВидовОтпусков();
	СоответствиеВидовОтпусковВозвратИзОУР = ПолучитьСоответствиеВидовОтпусковВозвратИзОУР();

	Для Каждого ЭлементОтпуска Из ПолучитьМассивЭлементовОтпуска(ПакетОбъектXDTO) Цикл

		МассивСтрок = ПолучитьМассивСтрокОтпуска(ЭлементОтпуска);
		Если МассивСтрок = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого СтрокаXDTO Из МассивСтрок Цикл

			Если СтрокаПакетаПропускается(СтрокаXDTO, СоответствиеПропускаемыхВидовОтпусков, СоответствиеВидовОтпусковВозвратИзОУР) Тогда
				Продолжить;
			КонецЕсли;

			ВидОтпускаИД = СокрЛП(СтрокаXDTO.ВидОтпуска);
			ПризнакиВида = ОпределитьПризнакиВидаОтпуска(ВидОтпускаИД);
			ДокументИД = ВычислитьИдентификаторДокумента(СтрокаXDTO, ПризнакиВида.ЭтоОтгул);
			ДобавитьСтрокуВГруппуДокументов(СоответствиеДанныхДокументов, ДокументИД, СтрокаXDTO);

		КонецЦикла;

	КонецЦикла;

	Возврат СоответствиеДанныхДокументов;

КонецФункции


#КонецОбласти

#Область ПредобработкаПакета

Функция ДатаИзСтрокиПакета(ЗначениеДаты)
	
	Если ТипЗнч(ЗначениеДаты) = Тип("Дата") Тогда
		Возврат ЗначениеДаты;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СокрЛП(ЗначениеДаты)) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	
	Возврат XMLЗначение(Тип("Дата"), ЗначениеДаты);
	
КонецФункции


Функция СмежныеКалендарныеДни(ДатаНачала, ДатаОкончанияПредыдущей)
	
	Возврат (ДатаНачала - ДатаОкончанияПредыдущей) / 86400 = 1;
	
КонецФункции


Функция ЕстьСтрокаПредоставленияВГруппе(МассивСтрокXDTO)
	
	Для Каждого СтрокаXDTO Из МассивСтрокXDTO Цикл
		Если СокрЛП(СтрокаXDTO.Действие) = "Предоставить" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции


Функция НайтиСтрокуПредоставленияВГруппе(МассивСтрокXDTO)
	
	Для Каждого СтрокаXDTO Из МассивСтрокXDTO Цикл
		Если СокрЛП(СтрокаXDTO.Действие) = "Предоставить" Тогда
			Возврат СтрокаXDTO;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции


Процедура ЗаписатьДатыСтрокиОтпускаВXDTO(СтрокаXDTO, ДатаНачала, ДатаОкончания, КоличествоДней = "")
	
	Если ДатаНачала <> Дата(1, 1, 1) Тогда
		СтрокаXDTO.ДатаНачалаОсновногоОтпуска = XMLСтрока(ДатаНачала);
	КонецЕсли;
	Если ДатаОкончания <> Дата(1, 1, 1) Тогда
		СтрокаXDTO.ДатаОкончанияОсновногоОтпуска = XMLСтрока(ДатаОкончания);
	КонецЕсли;
	Если КоличествоДней <> "" Тогда
		СтрокаXDTO.КоличествоДнейОсновногоОтпуска = КоличествоДней;
	КонецЕсли;
	
КонецПроцедуры


Процедура ПрименитьДатыПредоставленияВСтруктуруЗаполнения(СтруктураЗаполнения, СтрокаXDTOПредоставление)
	
	ДатаНачала = ДатаИзСтрокиПакета(СтрокаXDTOПредоставление.ДатаНачалаОсновногоОтпуска);
	ДатаОкончания = ДатаИзСтрокиПакета(СтрокаXDTOПредоставление.ДатаОкончанияОсновногоОтпуска);
	Если ДатаНачала = Дата(1, 1, 1) Или ДатаОкончания = Дата(1, 1, 1) Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоДней = СокрЛП(СтрокаXDTOПредоставление.КоличествоДнейОсновногоОтпуска);
	Если КоличествоДней = "" Тогда
		КоличествоДней = Строка((ДатаОкончания - ДатаНачала) / 86400 + 1);
	КонецЕсли;
	
	СтруктураЗаполнения.Вставить("ПредоставитьОсновнойОтпуск", Истина);
	СтруктураЗаполнения.Вставить("ДатаНачалаОсновногоОтпуска", ДатаНачала);
	СтруктураЗаполнения.Вставить("ДатаОкончанияОсновногоОтпуска", ДатаОкончания);
	СтруктураЗаполнения.Вставить("КоличествоДнейОсновногоОтпуска", КоличествоДней);
	СтруктураЗаполнения.Вставить("ДатаНачалаСобытия", ДатаНачала);
	СтруктураЗаполнения.Вставить("ДатаРасчетаДенежногоСодержания", ДатаНачала);
	
КонецПроцедуры


Функция СоздатьТаблицаОтпусковПоXDTO(СтрокаXDTO)
	
	ТаблицаОтпусков = Новый ТаблицаЗначений;
	Для Каждого СвойствоXDTO Из СтрокаXDTO.Свойства() Цикл
		ТаблицаОтпусков.Колонки.Добавить(СвойствоXDTO.Имя);
	КонецЦикла;
	ТаблицаОтпусков.Колонки.Добавить("НомерСтроки");
	
	Возврат ТаблицаОтпусков;
	
КонецФункции


Процедура ЗаполнитьДатыСтрокиТаблицыОтпуска(СтрокаТаблицы, СтрокаXDTO)
	
	СтрокаТаблицы.ДатаНачалаОсновногоОтпуска = ДатаИзСтрокиПакета(СтрокаXDTO.ДатаНачалаОсновногоОтпуска);
	СтрокаТаблицы.ДатаОкончанияОсновногоОтпуска = ДатаИзСтрокиПакета(СтрокаXDTO.ДатаОкончанияОсновногоОтпуска);
	СтрокаТаблицы.НачалоПериодаЗаКоторыйПредоставляетсяОтпуск = ДатаИзСтрокиПакета(СтрокаXDTO.НачалоПериодаЗаКоторыйПредоставляетсяОтпуск);
	СтрокаТаблицы.КонецПериодаЗаКоторыйПредоставляетсяОтпуск = ДатаИзСтрокиПакета(СтрокаXDTO.КонецПериодаЗаКоторыйПредоставляетсяОтпуск);
	
КонецПроцедуры


Процедура ЗаписатьДатыОтпускаВXDTO(СтрокаXDTO)
	
	ДатаНачала = ДатаИзСтрокиПакета(СтрокаXDTO.ДатаНачалаОсновногоОтпуска);
	ДатаОкончания = ДатаИзСтрокиПакета(СтрокаXDTO.ДатаОкончанияОсновногоОтпуска);
	НачалоПериода = ДатаИзСтрокиПакета(СтрокаXDTO.НачалоПериодаЗаКоторыйПредоставляетсяОтпуск);
	КонецПериода = ДатаИзСтрокиПакета(СтрокаXDTO.КонецПериодаЗаКоторыйПредоставляетсяОтпуск);
	
	Если ДатаНачала <> Дата(1, 1, 1) Тогда
		СтрокаXDTO.ДатаНачалаОсновногоОтпуска = XMLСтрока(ДатаНачала);
	КонецЕсли;
	Если ДатаОкончания <> Дата(1, 1, 1) Тогда
		СтрокаXDTO.ДатаОкончанияОсновногоОтпуска = XMLСтрока(ДатаОкончания);
	КонецЕсли;
	Если НачалоПериода <> Дата(1, 1, 1) Тогда
		СтрокаXDTO.НачалоПериодаЗаКоторыйПредоставляетсяОтпуск = XMLСтрока(НачалоПериода);
	КонецЕсли;
	Если КонецПериода <> Дата(1, 1, 1) Тогда
		СтрокаXDTO.КонецПериодаЗаКоторыйПредоставляетсяОтпуск = XMLСтрока(КонецПериода);
	КонецЕсли;
	
КонецПроцедуры


Функция ПолучитьИлиСоздатьМассивДокумента(СоответствиеДанныхДокументов, КлючДокумента)
	
	МассивСтрокДанных = СоответствиеДанныхДокументов.Получить(КлючДокумента);
	Если МассивСтрокДанных = Неопределено Тогда
		МассивСтрокДанных = Новый Массив;
		СоответствиеДанныхДокументов.Вставить(КлючДокумента, МассивСтрокДанных);
	КонецЕсли;
	
	Возврат МассивСтрокДанных;
	
КонецФункции


Процедура УдалитьИндексыИзМассиваУбывающе(МассивСтрок, МассивИндексов)
	
	Если МассивИндексов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(МассивИндексов);
	Список.СортироватьПоЗначению(НаправлениеСортировки.Возр);
	ИндексыУдаления = Список.ВыгрузитьЗначения();
	
	Для ОИ = -ИндексыУдаления.ВГраница() По 0 Цикл
		МассивСтрок.Удалить(ИндексыУдаления[-ОИ]);
	КонецЦикла;
	
КонецПроцедуры


Процедура ОбъединитьПериодыВПервойСтроке(ПерваяСтрока, ТекСтрока)
	
	ПерваяСтрока.ДатаОкончанияОсновногоОтпуска = ТекСтрока.ДатаОкончанияОсновногоОтпуска;
	ПерваяСтрока.КоличествоДнейОсновногоОтпуска = Строка(
		Число(ПерваяСтрока.КоличествоДнейОсновногоОтпуска) + Число(ТекСтрока.КоличествоДнейОсновногоОтпуска));
	ПерваяСтрока.КонецПериодаЗаКоторыйПредоставляетсяОтпуск = ?(
		ТекСтрока.КонецПериодаЗаКоторыйПредоставляетсяОтпуск > ПерваяСтрока.КонецПериодаЗаКоторыйПредоставляетсяОтпуск,
		ТекСтрока.КонецПериодаЗаКоторыйПредоставляетсяОтпуск,
		ПерваяСтрока.КонецПериодаЗаКоторыйПредоставляетсяОтпуск);
	ПерваяСтрока.НачалоПериодаЗаКоторыйПредоставляетсяОтпуск = ?(
		ТекСтрока.НачалоПериодаЗаКоторыйПредоставляетсяОтпуск > ПерваяСтрока.НачалоПериодаЗаКоторыйПредоставляетсяОтпуск,
		ПерваяСтрока.НачалоПериодаЗаКоторыйПредоставляетсяОтпуск,
		ТекСтрока.НачалоПериодаЗаКоторыйПредоставляетсяОтпуск);
	
КонецПроцедуры


Функция ОбъединитьСмежныеСтрокиТаблицы(Строки)
	
	Если Строки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПерваяСтрока = Строки[0];
	Если Строки.Количество() = 1 Тогда
		Возврат ПерваяСтрока;
	КонецЕсли;
	
	КонецОбъединенногоПериода = ПерваяСтрока.ДатаОкончанияОсновногоОтпуска;
	Для Индекс = 1 По Строки.ВГраница() Цикл
		ТекСтрока = Строки[Индекс];
		Если СмежныеКалендарныеДни(ТекСтрока.ДатаНачалаОсновногоОтпуска, КонецОбъединенногоПериода) Тогда
			ОбъединитьПериодыВПервойСтроке(ПерваяСтрока, ТекСтрока);
			КонецОбъединенногоПериода = ПерваяСтрока.ДатаОкончанияОсновногоОтпуска;
		КонецЕсли;
	КонецЦикла;
	
	ПерваяСтрока.ДатаНачалаОсновногоОтпуска = МинимальнаяДатаНачалаОсновногоОтпуска(Строки);
	ПерваяСтрока.ДатаОкончанияОсновногоОтпуска = МаксимальнаяДатаОкончанияОсновногоОтпуска(Строки);
	ПересчитатьКоличествоДнейСтрокиОтпуска(ПерваяСтрока);
	
	Возврат ПерваяСтрока;
	
КонецФункции


Процедура ОбработатьМатПомощьИЕДВ(МассивСтрокXDTO)
	
	ЕстьМатПомощь = Ложь;
	ЕстьЕДВ = Ложь;
	МассивСтрокУд = Новый Массив;
	НомерСтроки = 0;
	
	Для Каждого СтрОтпуск Из МассивСтрокXDTO Цикл
		Если СтрОтпуск.ПредоставитьМатериальнуюПомощьПриОтпуске = "1" Тогда
			ЕстьМатПомощь = Истина;
			МассивСтрокУд.Добавить(НомерСтроки);
		ИначеЕсли СтрОтпуск.ПредоставитьЕдиновременнуюВыплатуКОтпуску = "1" Тогда
			ЕстьЕДВ = Истина;
			МассивСтрокУд.Добавить(НомерСтроки);
		КонецЕсли;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	Если ЕстьМатПомощь И ЕстьЕДВ И МассивСтрокXDTO.Количество() = 2 Тогда
		МассивСтрокXDTO[0].ПредоставитьМатериальнуюПомощьПриОтпуске = "1";
		МассивСтрокXDTO[0].ПредоставитьЕдиновременнуюВыплатуКОтпуску = "1";
		МассивСтрокXDTO.Удалить(1);
	Иначе
		КоличествоУдалений = МассивСтрокУд.Количество();
		Для Номер = 1 По КоличествоУдалений Цикл
			ОбратныйИндекс = КоличествоУдалений - Номер;
			МассивСтрокXDTO.Удалить(МассивСтрокУд[ОбратныйИндекс]);
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого СтрОтпуск Из МассивСтрокXDTO Цикл
		Если ЕстьМатПомощь Тогда
			СтрОтпуск.ПредоставитьМатериальнуюПомощьПриОтпуске = "1";
		КонецЕсли;
		Если ЕстьЕДВ Тогда
			СтрОтпуск.ПредоставитьЕдиновременнуюВыплатуКОтпуску = "1";
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры


Функция СобратьТаблицаОтпусковДляОтзыва(МассивСтрокXDTO, ТаблицаОтпусков)
	
	ЕстьОтзыв = Ложь;
	ЕстьПредоставление = Ложь;
	НомерСтроки = 0;
	
	Для Каждого СтрокаОтпусков Из МассивСтрокXDTO Цикл
		Если Не ЗначениеЗаполнено(СтрокаОтпусков.ДатаНачалаОсновногоОтпуска)
			И Не ЗначениеЗаполнено(СтрокаОтпусков.ДатаОкончанияОсновногоОтпуска) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаОтпусков.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОтпусков);
		ЗаполнитьДатыСтрокиТаблицыОтпуска(НоваяСтрока, СтрокаОтпусков);
		НоваяСтрока.НомерСтроки = НомерСтроки;
		НомерСтроки = НомерСтроки + 1;
		
		ДействиеСтроки = СокрЛП(СтрокаОтпусков.Действие);
		Если ДействиеСтроки = "Отозвать" Тогда
			ЕстьОтзыв = Истина;
		ИначеЕсли ДействиеСтроки = "Предоставить" Тогда
			ЕстьПредоставление = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Новый Структура("ЕстьОтзыв, ЕстьПредоставление", ЕстьОтзыв, ЕстьПредоставление);
	
КонецФункции


Функция ИсправительныйИзСтрокОтзыва(Отзывы)
	
	Для Каждого СтрокаОтзыва Из Отзывы Цикл
		Если ЗначениеЗаполнено(СокрЛП(СтрокаОтзыва.Исправительный)) Тогда
			Возврат СокрЛП(СтрокаОтзыва.Исправительный);
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции


Процедура ЗаполнитьИсправительныйВНазначениях(Отпуска, МассивСтрокXDTO, ИсправительныйНомер, ПерваяСтрока = Неопределено)
	
	Если Не ЗначениеЗаполнено(ИсправительныйНомер) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаПредоставления Из Отпуска Цикл
		Если ЗначениеЗаполнено(СокрЛП(СтрокаПредоставления.Исправительный)) Тогда
			Продолжить;
		КонецЕсли;
		СтрокаПредоставления.Исправительный = ИсправительныйНомер;
		СтрокаXDTO = МассивСтрокXDTO[СтрокаПредоставления.НомерСтроки];
		Если СтрокаXDTO.Свойства().Получить("Исправительный") <> Неопределено Тогда
			СтрокаXDTO.Исправительный = ИсправительныйНомер;
		КонецЕсли;
	КонецЦикла;
	
	Если ПерваяСтрока <> Неопределено И Не ЗначениеЗаполнено(СокрЛП(ПерваяСтрока.Исправительный)) Тогда
		ПерваяСтрока.Исправительный = ИсправительныйНомер;
	КонецЕсли;
	
КонецПроцедуры


Процедура УстановитьИсправительныйВXDTO(СтрокаXDTO, ИсправительныйНомер)
	
	Если Не ЗначениеЗаполнено(ИсправительныйНомер) Тогда
		Возврат;
	КонецЕсли;
	Если СтрокаXDTO.Свойства().Получить("Исправительный") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаXDTO.Исправительный = ИсправительныйНомер;
	
КонецПроцедуры


Функция ОбработатьОтзывИПредоставление(СоответствиеДанныхДокументов, ЭлементДанных)
	
	Результат = Новый Структура("Обработано, ЕстьОтзыв, ЕстьПредоставление", Ложь, Ложь, Ложь);
	МассивСтрокXDTO = ЭлементДанных.Значение;
	ТаблицаОтпусков = СоздатьТаблицаОтпусковПоXDTO(МассивСтрокXDTO[0]);
	
	ФлагиОтзыва = СобратьТаблицаОтпусковДляОтзыва(МассивСтрокXDTO, ТаблицаОтпусков);
	Результат.ЕстьОтзыв = ФлагиОтзыва.ЕстьОтзыв;
	Результат.ЕстьПредоставление = ФлагиОтзыва.ЕстьПредоставление;
	
	Если Не (ФлагиОтзыва.ЕстьОтзыв И ФлагиОтзыва.ЕстьПредоставление) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТаблицаОтпусков.Сортировать("Действие Возр, ДатаНачалаОсновногоОтпуска Возр");
	Отзывы = ТаблицаОтпусков.НайтиСтроки(Новый Структура("Действие", "Отозвать"));
	Отпуска = ТаблицаОтпусков.НайтиСтроки(Новый Структура("Действие", "Предоставить"));
	
	СтрокаОтзываОбъединенная = ОбъединитьСмежныеСтрокиТаблицы(Отзывы);
	СтрокаПредоставленияОбъединенная = ОбъединитьСмежныеСтрокиТаблицы(Отпуска);
	ИсправительныйНомер = ИсправительныйИзСтрокОтзыва(Отзывы);
	ЗаполнитьИсправительныйВНазначениях(Отпуска, МассивСтрокXDTO, ИсправительныйНомер, СтрокаПредоставленияОбъединенная);
	
	СтрокаПредоставленияИтог = СтрокаПредоставленияОбъединенная;
	СтрокаПредоставленияИтог.Действие = "Предоставить";
	СтрокаПредоставленияИтог.Исправительный = ИсправительныйНомер;
	
	СтрокаОтзываИтог = СтрокаОтзываОбъединенная;
	СтрокаОтзываИтог.Действие = "Отозвать";
	
	ИсправительныйУИД = СтрокаОтзываОбъединенная.Исправительный + "_" + СтрокаОтзываОбъединенная.Сотрудник;
	ОтпускИсправляемый = Документы.Отпуск.НайтиПоРеквизиту("омУИД", ИсправительныйУИД);
	
	Если ЗначениеЗаполнено(ОтпускИсправляемый) Тогда
		Если ОтзывПолностьюСовпадаетСОтпуском(ОтпускИсправляемый, СтрокаОтзываОбъединенная) Тогда
			ПересчитатьКоличествоДнейСтрокиОтпуска(СтрокаПредоставленияИтог);
		ИначеЕсли ОтзывСНачалаИсправляемогоОтпуска(ОтпускИсправляемый, Отзывы) Тогда
			СтрокаПредоставленияИтог.ДатаНачалаОсновногоОтпуска = ОтпускИсправляемый.ДатаНачалаОсновногоОтпуска;
			СтрокаПредоставленияИтог.ДатаОкончанияОсновногоОтпуска = МаксимальнаяДатаНачалаОсновногоОтпуска(Отпуска);
			ПересчитатьКоличествоДнейСтрокиОтпуска(СтрокаПредоставленияИтог);
		ИначеЕсли ОтзывСКонцаИсправляемогоОтпуска(ОтпускИсправляемый, Отзывы) Тогда
			СтрокаПредоставленияИтог.ДатаНачалаОсновногоОтпуска = МинимальнаяДатаНачалаОсновногоОтпуска(Отпуска);
			СтрокаПредоставленияИтог.ДатаОкончанияОсновногоОтпуска = ОтпускИсправляемый.ДатаОкончанияОсновногоОтпуска;
			ПересчитатьКоличествоДнейСтрокиОтпуска(СтрокаПредоставленияИтог);
		ИначеЕсли МинимальнаяДатаНачалаОсновногоОтпуска(Отпуска) < ОтпускИсправляемый.ДатаНачалаОсновногоОтпуска Тогда
			СтрокаПредоставленияИтог.ДатаНачалаОсновногоОтпуска = МинимальнаяДатаНачалаОсновногоОтпуска(Отпуска);
			СтрокаПредоставленияИтог.ДатаОкончанияОсновногоОтпуска = МаксимальнаяДатаОкончанияОсновногоОтпуска(Отпуска);
			ПересчитатьКоличествоДнейСтрокиОтпуска(СтрокаПредоставленияИтог);
		Иначе
			ПересчитатьКоличествоДнейСтрокиОтпуска(СтрокаПредоставленияИтог);
		КонецЕсли;
	Иначе
		ПересчитатьКоличествоДнейСтрокиОтпуска(СтрокаПредоставленияИтог);
	КонецЕсли;
	
	ПересчитатьКоличествоДнейСтрокиОтпуска(СтрокаОтзываИтог);
	
	УстановитьИтогОтзывИПредоставление(
		ЭлементДанных,
		МассивСтрокXDTO,
		СтрокаПредоставленияИтог,
		СтрокаОтзываИтог);
	
	Результат.Обработано = Истина;
	Возврат Результат;
	
КонецФункции


Функция ОпределитьВидОтпускаДляСвертки(КодВидаОтпуска)
	
	Если КодВидаОтпуска = "251731550" Тогда
		Возврат "251731550";
	ИначеЕсли КодВидаОтпуска = "266514749" Тогда
		Возврат "266514749";
	ИначеЕсли КодВидаОтпуска = "232132145" Тогда
		Возврат "232132145";
	ИначеЕсли КодВидаОтпуска = "54264136" Тогда
		Возврат "54264136";
	ИначеЕсли КодВидаОтпуска = "54260853" Тогда
		Возврат "54260853";
	ИначеЕсли КодВидаОтпуска = "297765839" Тогда
		Возврат "297765839";
	ИначеЕсли КодВидаОтпуска = "221062297" Тогда
		Возврат "221062297";
	ИначеЕсли КодВидаОтпуска = "221065231" Тогда
		Возврат "221065231";
	Иначе
		Возврат "54253346";
	КонецЕсли;
	
КонецФункции


Функция СтрокаОтпускаПодлежитСвертке(СтрокаXDTO)
	
	Возврат СтрокаXDTO.ПредоставитьОсновнойОтпуск = "1"
		Или СтрокаXDTO.ВидОтпуска = "54260515"
		Или СтрокаXDTO.ПредоставитьДополнительныйОтпуск = "1"
		Или СтрокаXDTO.ВидОтпуска = "251731550";
	
КонецФункции


Функция СтрокаОтпускаИсключенаИзСвертки(СтрокаXDTO)
	
	Возврат СтрокаXDTO.ПредоставитьКомпенсациюОсновногоОтпуска = "1"
		Или СтрокаXDTO.ПредоставитьКомпенсациюДополнительногоОтпуска = "1"
		Или СтрокаXDTO.ВидОтпуска = "266514749"
		Или СтрокаXDTO.ВидОтпуска = "236498269"
		Или СтрокаXDTO.ВидОтпуска = "232132145"
		Или СтрокаXDTO.ВидОтпуска = "54260853"
		Или СтрокаXDTO.ВидОтпуска = "256880646"
		Или СтрокаXDTO.ВидОтпуска = "106790553"
		Или СтрокаXDTO.ВидОтпуска = "106733692";
	
КонецФункции


Процедура СвернутьСмежныеПериодыОтпуска(СоответствиеДанныхДокументов, ЭлементДанных, ЕстьОтзыв, ЕстьПредоставление)
	
	МассивСтрокXDTO = ЭлементДанных.Значение;
	ДокументИД = ЭлементДанных.Ключ;
	ТаблицаОтпусков = СоздатьТаблицаОтпусковПоXDTO(МассивСтрокXDTO[0]);
	НомерСтроки = 0;
	
	Для Каждого ТекСтрокаЗначение Из МассивСтрокXDTO Цикл
		Если СтрокаОтпускаПодлежитСвертке(ТекСтрокаЗначение) Тогда
			Если СтрокаОтпускаИсключенаИзСвертки(ТекСтрокаЗначение) Тогда
				НомерСтроки = НомерСтроки + 1;
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ТаблицаОтпусков.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрокаЗначение);
			НоваяСтрока.ВидОтпуска = ОпределитьВидОтпускаДляСвертки(ТекСтрокаЗначение.ВидОтпуска);
			ЗаполнитьДатыСтрокиТаблицыОтпуска(НоваяСтрока, ТекСтрокаЗначение);
			НоваяСтрока.НомерСтроки = НомерСтроки;
		КонецЕсли;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	ТаблицаОтпусков.Сортировать("ВидОтпуска, ДатаНачалаОсновногоОтпуска Возр");
	ПредСтрока = Неопределено;
	МассивУдаления = Новый Массив;
	
	Для Каждого ТекСтрока Из ТаблицаОтпусков Цикл
		Если ПредСтрока = Неопределено
			Или ПредСтрока.ВидОтпуска <> ТекСтрока.ВидОтпуска
			Или ТекСтрока.Сотрудник <> ПредСтрока.Сотрудник Тогда
			ПредСтрока = ТекСтрока;
			Продолжить;
		КонецЕсли;
		
		СтрокаXDTO = МассивСтрокXDTO[ПредСтрока.НомерСтроки];
		СтрокаXDTOТек = МассивСтрокXDTO[ТекСтрока.НомерСтроки];
		
		Если СмежныеКалендарныеДни(ТекСтрока.ДатаНачалаОсновногоОтпуска, ПредСтрока.ДатаОкончанияОсновногоОтпуска) Тогда
			МассивУдаления.Добавить(ТекСтрока.НомерСтроки);
			СтрокаXDTO.Установить("ДатаОкончанияОсновногоОтпуска", СтрокаXDTOТек.ДатаОкончанияОсновногоОтпуска);
			ПредСтрока.ДатаОкончанияОсновногоОтпуска = ТекСтрока.ДатаОкончанияОсновногоОтпуска;
			Если ТекСтрока.ВидОтпуска = "251731550"
				Или ТекСтрока.ВидОтпуска = "266514749"
				Или ТекСтрока.ВидОтпуска = "297765839" Тогда
				СтрокаXDTO.Установить("КоличествоДнейОсновногоОтпуска", "0");
			Иначе
				СтрокаXDTO.Установить("КоличествоДнейОсновногоОтпуска", Строка(
					Число(СтрокаXDTOТек.КоличествоДнейОсновногоОтпуска) + Число(СтрокаXDTO.КоличествоДнейОсновногоОтпуска)));
			КонецЕсли;
			СтрокаXDTO.Установить("КонецПериодаЗаКоторыйПредоставляетсяОтпуск", ?(
				ТекСтрока.КонецПериодаЗаКоторыйПредоставляетсяОтпуск > ПредСтрока.КонецПериодаЗаКоторыйПредоставляетсяОтпуск,
				СтрокаXDTOТек.КонецПериодаЗаКоторыйПредоставляетсяОтпуск,
				СтрокаXDTO.КонецПериодаЗаКоторыйПредоставляетсяОтпуск));
			СтрокаXDTO.Установить("НачалоПериодаЗаКоторыйПредоставляетсяОтпуск", ?(
				ТекСтрока.НачалоПериодаЗаКоторыйПредоставляетсяОтпуск > ПредСтрока.НачалоПериодаЗаКоторыйПредоставляетсяОтпуск,
				СтрокаXDTO.НачалоПериодаЗаКоторыйПредоставляетсяОтпуск,
				СтрокаXDTOТек.НачалоПериодаЗаКоторыйПредоставляетсяОтпуск));
		ИначеЕсли ТекСтрока.ДатаНачалаОсновногоОтпуска <> Дата(1, 1, 1)
			И ТекСтрока.Действие <> "Отозвать" Тогда
			МассивУдаления.Добавить(ТекСтрока.НомерСтроки);
			ДатаНачалаСтрокаДляИД = Формат(ТекСтрока.ДатаНачалаОсновногоОтпуска, "ДФ=ггггММдд");
			НовыйДокументИД = ДокументИД + "_" + ДатаНачалаСтрокаДляИД;
			МассивНовогоДокумента = ПолучитьИлиСоздатьМассивДокумента(СоответствиеДанныхДокументов, НовыйДокументИД);
			МассивНовогоДокумента.Добавить(СтрокаXDTOТек);
			ПредСтрока = ТекСтрока;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЕстьПредоставление И Не ЕстьОтзыв Тогда
		Для Каждого НомерУдаляемойСтроки Из МассивУдаления Цикл
			СтрокаТаблицы = ТаблицаОтпусков.Найти(НомерУдаляемойСтроки, "НомерСтроки");
			Если СтрокаТаблицы <> Неопределено Тогда
				ТаблицаОтпусков.Удалить(СтрокаТаблицы);
			КонецЕсли;
		КонецЦикла;
		Для Каждого Отпуск Из ТаблицаОтпусков Цикл
			Если ЭлементДанных.Значение[Отпуск.НомерСтроки].ВидОтпуска <> Отпуск.ВидОтпуска Тогда
				ЭлементДанных.Значение[Отпуск.НомерСтроки].ВидОтпуска = Отпуск.ВидОтпуска;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	УдалитьИндексыИзМассиваУбывающе(ЭлементДанных.Значение, МассивУдаления);
	
КонецПроцедуры


Процедура НормализоватьВидыОтпускаВМассиве(МассивСтрокXDTO)
	
	Если МассивСтрокXDTO.Количество() = 1 Тогда
		ВидОтпуска = МассивСтрокXDTO[0].ВидОтпуска;
		Если ВидОтпуска <> "297765839"
			И ВидОтпуска <> "251731550"
			И ВидОтпуска <> "266514749"
			И ВидОтпуска <> "232132145"
			И ВидОтпуска <> "54264136"
			И ВидОтпуска <> "54260853"
			И ВидОтпуска <> "165779244"
			И ВидОтпуска <> "54260515"
			И ВидОтпуска <> "221062297"
			И ВидОтпуска <> "221065231" Тогда
			МассивСтрокXDTO[0].ВидОтпуска = "54253346";
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого СтрокаОтпусков Из МассивСтрокXDTO Цикл
		Если СтрокаОтпусков.ВидОтпуска = "54253351" Или СтрокаОтпусков.ВидОтпуска = "54253356" Тогда
			СтрокаОтпусков.ВидОтпуска = "54253346";
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

//+++Каб Парамонов 16.06.22
//Свертка отпуска

Процедура ДополнительнаяОбработкаОтпуска(СоответствиеДанныхДокументов)
	
	Если СоответствиеДанныхДокументов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлементДанных Из СоответствиеДанныхДокументов Цикл
		МассивСтрокXDTO = ЭлементДанных.Значение;
		Если МассивСтрокXDTO.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		
		ОбработатьМатПомощьИЕДВ(МассивСтрокXDTO);
		
		РезультатОтзыва = ОбработатьОтзывИПредоставление(СоответствиеДанныхДокументов, ЭлементДанных);
		Если РезультатОтзыва.Обработано Тогда
			Продолжить;
		КонецЕсли;
		
		СвернутьСмежныеПериодыОтпуска(
			СоответствиеДанныхДокументов,
			ЭлементДанных,
			РезультатОтзыва.ЕстьОтзыв,
			РезультатОтзыва.ЕстьПредоставление);
		НормализоватьВидыОтпускаВМассиве(МассивСтрокXDTO);
	КонецЦикла;
	
КонецПроцедуры
