			Для Каждого Запись Из МассивДатОтзыва Цикл
				
				//+ КАБ Куцеборский 01.11.22
				Период = ОтпускОбъект.ПериодыПриостановкиОтпуска.Добавить();
				Период.ДатаНачалаПериода = Запись.ДатаНачалаОсновногоОтпуска ;
				Период.ДатаОкончанияПериода = Запись.ДатаОкончанияОсновногоОтпуска;
				Период.КоличествоДнейПриостановки = Запись.КоличествоДнейОсновногоОтпуска;
				//-КАБ Куцеборский
				ОтпускОбъект.ДоначислитьЗарплатуПриНеобходимости = Истина;
				
			КонецЦикла;		
			
			ОтпускОбъект.Начисления.Очистить();
		КонецЕсли;
		
		////+КАБ Кириллова 23.06.2022       
		ОтпускОбъект.РасчетДенежногоСодержания = Ложь;
		
		КДСотр = КадровыйУчет.КадровыеДанныеСотрудников(Истина, ОтпускОбъект.Сотрудник, "Должность,ВидДоговора,Подразделение", ОтпускОбъект.Дата,  Неопределено,  Истина); 
		Если КдСотр[0].ВидДоговора = Перечисления.ВидыДоговоровССотрудниками.ТрудовойДоговор Тогда
			ЗарплатаКадрыРасширенный.УстановитьВариантРасчетаДокументаПоСреднемуЗаработку(ОтпускОбъект);  
		Иначе
			отпускОбъект.РасчетДенежногоСодержания = Истина;
		КонецЕсли;	
		Если Не ЗначениеЗаполнено(ОтпускОбъект.ДатаНачалаСобытия) 
			Или Не ЗначениеЗаполнено(ОтпускОбъект.Сотрудник) Тогда
		иначе
			ВидРасчета = ?(ТолькоКомпенсация(ОтпускОбъект), ОтпускОбъект.ВидРасчетаКомпенсацииОсновногоОтпуска, ОтпускОбъект.ВидРасчетаОсновногоОтпуска);
			ПериодРасчетаСреднего = УчетСреднегоЗаработка.ПериодРасчетаОбщегоСреднегоЗаработкаСотрудника(ОтпускОбъект.ДатаНачалаСобытия, ОтпускОбъект.Сотрудник, ВидРасчета);
			ОтпускОбъект.ПериодРасчетаСреднегоЗаработкаНачало		= ПериодРасчетаСреднего.ДатаНачала;
			ОтпускОбъект.ПериодРасчетаСреднегоЗаработкаОкончание 	= ПериодРасчетаСреднего.ДатаОкончания; 				
		КонецЕсли;
		
		//-КАБ Кириллова 23.06.2022
	ИначеЕсли ДокументДляЗагрузки = "РазовоеНачисление" тогда
		ОтпускОбъект.Начисления.Очистить();   
		
		НовФизЛицо = ОтпускОбъект.ФизическиеЛица.Добавить();
		НовФизЛицо.ФизическоеЛицо = ФизЛицоСсылка;
		
		НовПоказателиТЧ = ОтпускОбъект.Показатели.Добавить();
		НовПоказателиТЧ.Показатель = Справочники.ПоказателиРасчетаЗарплаты.НайтиПоНаименованию("ПроцентДляКомпенсацииНаСанаторноКурортноеЛечение");
		НовПоказателиТЧ.Значение = ПроцентДляКомпенсацииНаСанаторноКурортноеЛечение;
		НовПоказателиТЧ = ОтпускОбъект.Показатели.Добавить();
		НовПоказателиТЧ.Показатель = Показатель;
		НовПоказателиТЧ.Значение = МаксимальнаяСтоимостьСанаторноКурортнойПутевки;
		
		НовНачисленияТЧ = ОтпускОбъект.Начисления.Добавить();
		НовНачисленияТЧ.Сотрудник = СотрудникСсылка;
		//+КАБ Кириллова 210722
		КДСотр = КадровыйУчет.КадровыеДанныеСотрудников(Истина, СотрудникСсылка, "Должность,ВидДоговора,Подразделение", ДатаПриказа,  Неопределено,  Истина); 
		НовНачисленияТЧ.подразделение = КДСотр.получить(0).подразделение ;
		//- КАБ Кириллова
		НовНачисленияТЧ.ДатаНачала = НачалоМесяца(ДатаПриказа);
		НовНачисленияТЧ.ДатаОкончания = КонецМесяца(ДатаПриказа);
		НовНачисленияТЧ.ПериодДействия = НачалоМесяца(ДатаПриказа);
		НовНачисленияТЧ.Результат = Вычислить(ФормулаДляРасчета);
		Если ЗначениеЗаполнено(ОтпускОбъект.ИсправленныйДокумент) Тогда
			ОтпускОбъект.НачисленияПерерасчет.Очистить();
			ПересчетТЧ = ОтпускОбъект.НачисленияПерерасчет.Добавить();
			ПересчетТЧ.Сотрудник = СотрудникСсылка;
			ПересчетТЧ.Подразделение = КДСотр.получить(0).подразделение ;
			ПересчетТЧ.Начисление = ВидРасчетаСсылка;
			ПересчетТЧ.Результат = 0 - ОтпускОбъект.ИсправленныйДокумент.Начисления[0].Результат;
		КонецЕсли;
		//+КАБ Кириллова 22.07.2022
	ИначеЕсли ДокументДляЗагрузки = "РаботаВВыходныеИПраздничныеДни" тогда
		//+ КАБ кириллова 240722
		ОтпускОбъект.Причина = НомерПриказа;
		ОтпускОбъект.ВремяВЧасах=Ложь;
		ОтпускОбъект.СогласиеТребуется = Истина; 
		ОтпускОбъект.СогласиеПолучено = Истина;
		
		ОтпускОбъект.сотрудники.Очистить();
		ОтпускОбъект.ФизическиеЛица.Очистить();   
		Для Каждого СтруктураРаботаВВыходныеДни Из МассивРаботаВВыходныеДни Цикл
			МассивДнейВД = Новый Массив;
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивДнейВД, ПолучитьМассивДат(СтруктураРаботаВВыходныеДни.ДатаНачала,СтруктураРаботаВВыходныеДни.ДатаОкончания));
			Для каждого ТекДата из   МассивДнейВД Цикл	
				Если ТекДата< ОтпускОбъект.ДатаНачалаСобытия тогда
					ОтпускОбъект.ДатаНачалаСобытия = ТекДата;
				конецЕсли;						
				Новсотрудник =   ОтпускОбъект.Сотрудники.Добавить();
				Новсотрудник.Дата = ТекДата; 
				Новсотрудник.сотрудник = СтруктураРаботаВВыходныеДни.сотрудник;
				Если  СтруктураРаботаВВыходныеДни.СпособКомпенсацииПереработки = "привлечь к работе в выходные дни (за двойную оплату)" тогда
					Новсотрудник.СпособКомпенсацииПереработки = перечисления.СпособыКомпенсацииПереработки.ПовышеннаяОплата
				Иначе
					Новсотрудник.СпособКомпенсацииПереработки = перечисления.СпособыКомпенсацииПереработки.Отгул
				КонецЕсли;
				Новсотрудник.ОтработаноЧасов=8;
				Новсотрудник.НеРаботал = ложь;
			КонецЦикла;	   				
		КонецЦикла;
		
		//(+)Сапрыкин	 
	ИначеЕсли ДокументДляЗагрузки = "Отгул" тогда	 			 
		
		ОтпускОбъект.Заполнить(СтруктураЗаполнения.Сотрудник);
		ОтпускОбъект.омУИД = ДокументИД;
		
		Если НачалоДня(ДатаОкончанияОсновногоОтпуска) - НачалоДня(ДатаНачалаОсновногоОтпуска) = 0 Тогда
			ОтпускОбъект.КоличествоДнейОтгула = 1;
		Иначе	
			ОтпускОбъект.КоличествоДнейОтгула 	= (НачалоДня(ДатаОкончанияОсновногоОтпуска) - НачалоДня(ДатаНачалаОсновногоОтпуска)) / (60 * 60 * 24) +1;
		КонецЕсли;
		
		ОтпускОбъект.ДатаНачала 			= ДатаНачалаОсновногоОтпуска;
		ОтпускОбъект.ДатаОкончания 		= ДатаОкончанияОсновногоОтпуска;						
		ОтпускОбъект.ПериодРегистрации 	= ПериодРегистрации						
		//(-) Сапрыкин
	ИначеЕсли ЭтоОтпускБезСохраненияОплаты и ЭтоОтзыв тогда
		//Проверка на полный отзыв
		Если Исправление.ДатаНачала = ДатаНачалаОсновногоОтпуска и Исправление.ДатаОкончания = ДатаОкончанияОсновногоОтпуска Тогда
			ОтпускОбъект.ДатаНачала = Дата(1,1,1);
			ОтпускОбъект.ДатаОкончания = Дата(1,1,1);
		Иначе
			Если Исправление.ДатаНачала = ДатаНачалаОсновногоОтпуска Тогда
				ОтпускОбъект.ДатаНачала = КонецДня(ДатаОкончанияОсновногоОтпуска)+1;
			Иначе
				ОтпускОбъект.ДатаНачала = Исправление.ДатаНачала;
			КонецЕсли;
			Если Исправление.ДатаОкончания = ДатаОкончанияОсновногоОтпуска Тогда
				ОтпускОбъект.ДатаОкончания = НачалоДня(ДатаНачалаОсновногоОтпуска)-1;
			Иначе
				ОтпускОбъект.ДатаОкончания = Исправление.ДатаОкончания;	
			КонецЕсли;
		КонецЕсли;
		
		
		
	КонецЕсли; // по типам документов с различным доп.заполнением реквизитов	

КонецПроцедуры

Процедура СоздатьИлиОбновитьДокументОтпускаИзГруппы(КонтекстДокумента, КонтекстЗагрузки)

	МассивРаботаВВыходныеДни = КонтекстДокумента.МассивРаботаВВыходныеДни;
	ЕстьОшибкиПоДокументу = КонтекстДокумента.ЕстьОшибкиПоДокументу;
	ДокументИД = КонтекстДокумента.ДокументИД;
	МассивСтрокXDTO = КонтекстДокумента.МассивСтрокXDTO;
	НомерПриказа = КонтекстДокумента.НомерПриказа;
	ДатаПриказа = КонтекстДокумента.ДатаПриказа;
	ПериодРегистрации = КонтекстДокумента.ПериодРегистрации;
	ДокументДляЗагрузки = КонтекстДокумента.ДокументДляЗагрузки;
	СтруктураЗаполнения = КонтекстДокумента.СтруктураЗаполнения;
	МассивДополнительныеОтпуска = КонтекстДокумента.МассивДополнительныеОтпуска;
	МассивДнейУхода = КонтекстДокумента.МассивДнейУхода;
	БылПервыйДопОтп = КонтекстДокумента.БылПервыйДопОтп;
	МассивДатОтзыва = КонтекстДокумента.МассивДатОтзыва;
	УдалитьДни = КонтекстДокумента.УдалитьДни;
	ДействиеДокумента = КонтекстДокумента.ДействиеДокумента;
	ЭтоОтзыв = КонтекстДокумента.ЭтоОтзыв;
	ДатаНачалаОсновногоОтпуска = КонтекстДокумента.ДатаНачалаОсновногоОтпуска;
	ДатаОкончанияОсновногоОтпуска = КонтекстДокумента.ДатаОкончанияОсновногоОтпуска;
	ИсправлениеОт = КонтекстДокумента.ИсправлениеОт;
	НачалоПериодаЗаКоторыйПредоставляетсяОтпуск = КонтекстДокумента.НачалоПериодаЗаКоторыйПредоставляетсяОтпуск;
	КонецПериодаЗаКоторыйПредоставляетсяОтпуск = КонтекстДокумента.КонецПериодаЗаКоторыйПредоставляетсяОтпуск;
	КоличествоДнейОсновногоОтпуска = КонтекстДокумента.КоличествоДнейОсновногоОтпуска;
	КоличествоДнейКомпенсацииДополнительногоОтпуска = КонтекстДокумента.КоличествоДнейКомпенсацииДополнительногоОтпуска;
	ПредоставитьКомпенсациюОсновногоОтпуска = КонтекстДокумента.ПредоставитьКомпенсациюОсновногоОтпуска;
	КоличествоДнейКомпенсацииОсновногоОтпуска = КонтекстДокумента.КоличествоДнейКомпенсацииОсновногоОтпуска;
	ПредоставитьМатериальнуюПомощьПриОтпуске = КонтекстДокумента.ПредоставитьМатериальнуюПомощьПриОтпуске;
	ПредоставитьЕдиновременнуюВыплатуКОтпуску = КонтекстДокумента.ПредоставитьЕдиновременнуюВыплатуКОтпуску;
	ДатаОтпуска = КонтекстДокумента.ДатаОтпуска;
	ВидЗанятости = КонтекстДокумента.ВидЗанятости;
	СотрудникИД = КонтекстДокумента.СотрудникИД;
	ФизЛицоИД = КонтекстДокумента.ФизЛицоИД;
	ФизЛицоСсылка = КонтекстДокумента.ФизЛицоСсылка;
	ИсправлениеИД = КонтекстДокумента.ИсправлениеИД;
	ВидЗанятостиСтрока = КонтекстДокумента.ВидЗанятостиСтрока;
	ШтаткаИД = КонтекстДокумента.ШтаткаИД;
	ИсполнениеИД = КонтекстДокумента.ИсполнениеИД;
	СотрудникСсылка = КонтекстДокумента.СотрудникСсылка;
	ПроцентДляКомпенсацииНаСанаторноКурортноеЛечение = КонтекстДокумента.ПроцентДляКомпенсацииНаСанаторноКурортноеЛечение;
	ВидОтпускаИД = КонтекстДокумента.ВидОтпускаИД;
	ВидОтпускаНаименованиеПолное = КонтекстДокумента.ВидОтпускаНаименованиеПолное;
	ЭтоОтпускПоУходуЗаРебенком_15 = КонтекстДокумента.ЭтоОтпускПоУходуЗаРебенком_15;
	ЭтоОтпускПоУходуЗаРебенком_3 = КонтекстДокумента.ЭтоОтпускПоУходуЗаРебенком_3;
	ЭтоОтпускБезСохраненияОплаты = КонтекстДокумента.ЭтоОтпускБезСохраненияОплаты;
	ЭтоРаботаВВыходныеДни = КонтекстДокумента.ЭтоРаботаВВыходныеДни;
	ЭтоОтпускПоУходуЗаДетьмиИнвалидами = КонтекстДокумента.ЭтоОтпускПоУходуЗаДетьмиИнвалидами;
	ЭтоОплатаПоСреднемуЗаработку = КонтекстДокумента.ЭтоОплатаПоСреднемуЗаработку;
	ЭтоВозвратИзОУР = КонтекстДокумента.ЭтоВозвратИзОУР;
	ЭтоСанКур = КонтекстДокумента.ЭтоСанКур;
	ЭтоОтгул = КонтекстДокумента.ЭтоОтгул;
	ЭтоУченическийОтпуск = КонтекстДокумента.ЭтоУченическийОтпуск;
	ЭтоОсновнойОтпуск = КонтекстДокумента.ЭтоОсновнойОтпуск;
	ЭтоВидыДокументовБезВидаОтпуска = КонтекстДокумента.ЭтоВидыДокументовБезВидаОтпуска;
	ВидОтпускаСсылка = КонтекстДокумента.ВидОтпускаСсылка;
	ВидРасчетаСсылка = КонтекстДокумента.ВидРасчетаСсылка;
	ТекстОшибкиНеНайденВидОтпуска = КонтекстДокумента.ТекстОшибкиНеНайденВидОтпуска;
	ПредоставитьДополнительныйОтпуск = КонтекстДокумента.ПредоставитьДополнительныйОтпуск;
	ВидВремени = КонтекстДокумента.ВидВремени;
	КатегорияНачисления = КонтекстДокумента.КатегорияНачисления;
	Показатель = КонтекстДокумента.Показатель;
	МаксимальнаяСтоимостьСанаторноКурортнойПутевки = КонтекстДокумента.МаксимальнаяСтоимостьСанаторноКурортнойПутевки;
	ФормулаДляРасчета = КонтекстДокумента.ФормулаДляРасчета;
	СтруктураДат = КонтекстДокумента.СтруктураДат;
	ТекСтрокаЗначение = КонтекстДокумента.ТекСтрокаЗначение;
	
	Если КонтекстДокумента.Свойство("ПрерватьСтроки") И КонтекстДокумента.ПрерватьСтроки Тогда
	ЕстьОшибкиПоДокументу = Истина;
	КонецЕсли;
	ТекСтрокаЗначение = КонтекстДокумента.ТекСтрокаЗначение;
	
	Если ЕстьОшибкиПоДокументу Тогда
		Возврат; // не нужно обрабатывать негодный набор данных
	КонецЕсли;
	ИсправлениеФизлицо = "";
	ИсправлениеСотрудник = "";
	Если ДокументДляЗагрузки = "Отпуск" Тогда
		СтруктураЗаполнения.Вставить("ДополнительныеОтпуска", МассивДополнительныеОтпуска);
	КонецЕсли;

	Если ОбработатьСценарийПредоставитьОтозвать(КонтекстДокумента, КонтекстЗагрузки) Тогда
		Возврат;
	КонецЕсли;

	ДанныеИсправления = НайтиДокументИсправленияОтпуска(КонтекстДокумента, КонтекстЗагрузки);
	Если ДанныеИсправления.Обработано Тогда
		Возврат;
	КонецЕсли;
	Исправление = ДанныеИсправления.Исправление;

	ДанныеОтпуска = ПолучитьИлиСоздатьОбъектОтпуска(КонтекстДокумента, КонтекстЗагрузки, Исправление);
	Если ДанныеОтпуска.Обработано Тогда
		Возврат;
	КонецЕсли;
	ОтпускОбъект = ДанныеОтпуска.ОтпускОбъект;

	ЗаполнитьЗначенияСвойств(ОтпускОбъект, СтруктураЗаполнения); 
	//СООБЩИТЬ("Сотрудник " + СТРОКА(СтруктураЗаполнения.Сотрудник) + " тип " + СТРОКА(ТипЗнч(СтруктураЗаполнения.Сотрудник)));
	//СООБЩИТЬ("Сотрудник документа " + СТРОКА(ОтпускОбъект.Сотрудник) + " тип " + СТРОКА(ТипЗнч(ОтпускОбъект.Сотрудник)));
	//Если ДокументДляЗагрузки = "Отпуск" Тогда 
	Если ЭтоВозвратИзОУР <> Истина и ЭтоСанКур <> Истина Тогда
		ОтпускОбъект.ПериодРегистрации = ПериодРегистрации;    
	КонецЕсли;
	ОтпускОбъект.Комментарий = "Загружено из Парус " + СТРОКА(ТекущаяДата()) + "/номер приказа " + НомерПриказа + " от " + ФОРМАТ(ДатаПриказа, "ДФ=""дд.ММ.гггг""");
	

	ДозаполнитьОтпускПоВидуДокумента(ОтпускОбъект, КонтекстДокумента, КонтекстЗагрузки, Исправление);
	//+ Куцеборский 08.07.2022 Изменение даты документа на текущую
	ОтпускОбъект.Дата = НачалоДня(ТекущаяДата());
	//- Куцеборский 08.07.2022
	
	//Документы.РазовоеНачисление. ФормаДокумента.ПерезаполнитьДанныеФормыНаСервере(Справочники.Сотрудники.НайтиПоРеквизиту("ФизическоеЛицо",ФизЛицоСсылка));
	КонтекстЗагрузки.МассивДокументовОбъектов.Добавить(ОтпускОбъект);
	

КонецПроцедуры

// --- Обработка одной группы документов пакета ---
Процедура ОбработатьГруппуДокументовПакета(СоответствиеДанныхДокументовЭлемент, КонтекстДокумента, КонтекстЗагрузки)

	ИнициализироватьКонтекстГруппыДокументов(СоответствиеДанныхДокументовЭлемент, КонтекстДокумента);
	ОбработатьСтрокиГруппыДокументовПакета(КонтекстДокумента, КонтекстЗагрузки);
	СоздатьИлиОбновитьДокументОтпускаИзГруппы(КонтекстДокумента, КонтекстЗагрузки);

КонецПроцедуры


// --- Запись документов из пакета ---
Функция ЗаписатьДокументыОтпускаИзПакета(МассивДокументовОбъектов, ДокументДляЗагрузки, ТекстДляРегистрацииОшибки, ЕстьОшибкиУровняНеОжидание)
	Для Каждого ОтпускОбъект Из МассивДокументовОбъектов Цикл
		Если ТекстДляРегистрацииОшибки <> "" Тогда
			Прервать
		Иначе
			Попытка
				//////////ОтпускОбъект.ОбменДанными.Загрузка = Истина;
				///+++ Куцеборский 15.07.22
				Если  ТипЗнч(ОтпускОбъект) = Тип("ДокументСсылка.РазовоеНачисление") Тогда 
					ОтпускОбъект.омДокументЖдетРучнойОбработки = Истина;
				КонецЕсли;
				///--- Куцеборский
				//омОбщегоНазначенияСервер.ЗаписатьОбъектБезПроверокМО(ОтпускОбъект, РежимЗаписиДокумента.Запись);
				ОтпускОбъект.Записать(РежимЗаписиДокумента.Запись);
				//+ КАБ Куцеборский 23.12.22
				ПроверкаНаличияФайлов(ОтпускОбъект);
				//- КАБ Куцеборский 23.12.22
				СООБЩИТЬ("Записан: " + СТРОКА(ОтпускОбъект.Ссылка));
			Исключение
				ТекстДляРегистрацииОшибки = ТекстДляРегистрацииОшибки + ?(ТекстДляРегистрацииОшибки = "", "", Символы.ПС) + СтандартнаяСтрокаОшибки("Документ."+ДокументДляЗагрузки, ОтпускОбъект.омУИД, "НЕ ЗАПИСАН! " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	
	
	Если ТекстДляРегистрацииОшибки <> "" ТОгда
		Если ЕстьОшибкиУровняНеОжидание = Истина Тогда
			СООБЩИТЬ(ТекстДляРегистрацииОшибки);
			ВозврСтруктура = Новый Структура;
			ВозврСтруктура.Вставить("Статус", Перечисления.омСтатусыОчередиДанных.омОшибка);
			ВозврСтруктура.Вставить("ОписаниеОшибки", ТекстДляРегистрацииОшибки);
			Возврат ВозврСтруктура;
		Иначе
			ВозврСтруктура = Новый Структура;
			ВозврСтруктура.Вставить("Статус", Перечисления.омСтатусыОчередиДанных.омОжидание);
			ВозврСтруктура.Вставить("ОписаниеОшибки", ТекстДляРегистрацииОшибки);
			Возврат ВозврСтруктура;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Истина;

