Функция ЗагрузитьПакет_2020(ПакетОбъектXDTO)

	ДокументДляЗагрузки = "Отпуск";
	ТекстДляРегистрацииОшибки = "";
	РезультатЗагрузки = Истина;
	ЕстьОшибкиУровняНеОжидание = Ложь;

	ОрганизацияСсылка = РазрешитьОрганизациюПакета(ПакетОбъектXDTO);

	МетаданныеОрг = Справочники.омМетаданныеИС.НайтиПоНаименованию("Организации");
	МетаданныеПодразделения = Справочники.омМетаданныеИС.НайтиПоНаименованию("Подразделения");
	МетаданныеСотрудники = Справочники.омМетаданныеИС.НайтиПоНаименованию("Сотрудники");
	МетаданныеФизЛица = Справочники.омМетаданныеИС.НайтиПоНаименованию("Физические Лица");
	МетаданныеДолжности = Справочники.омМетаданныеИС.НайтиПоНаименованию("Должности");
	МетаданныеГрафика = Справочники.омМетаданныеИС.НайтиПоНаименованию("Графики работы сотрудников");
	МетаданныеПриема = Справочники.омМетаданныеИС.НайтиПоНаименованию("Прием на работу");
	МетаданныеШтатки = Справочники.омМетаданныеИС.НайтиПоНаименованию("Штатное расписание");
	МетаданныеНачислений = Справочники.омМетаданныеИС.НайтиПоНаименованию("Начисления");

	СоответствиеДанныхДокументов = СгруппироватьСтрокиПакетаПоДокументам(ПакетОбъектXDTO);
	СчетчикОтпусков = 0;
	КоличествоОтпусков = 0;

	ДополнительнаяОбработкаОтпуска(СоответствиеДанныхДокументов);
	//Каб Парамонов 16.06.22

	//+ КАБ Куцеборский 29.08.22
	ОбработкаКомпенсаций(СоответствиеДанныхДокументов);
	//- КАБ Куцеборский
	Если ЕстьОшибкиУровняНеОжидание = Истина Тогда
		ВозврСтруктура = Новый Структура;
		ВозврСтруктура.Вставить("Статус", Перечисления.омСтатусыОчередиДанных.омОшибка);
		ВозврСтруктура.Вставить("ОписаниеОшибки", ТекстДляРегистрацииОшибки);
		Возврат ВозврСтруктура;
	КонецЕсли;

	Если СоответствиеДанныхДокументов.Количество() = 0 Тогда
		Возврат Истина; // пакет пустой, данных в нём нет
	КонецЕсли;

	Запросы = ИнициализироватьЗапросыЗагрузкиОтпуска();
	СоответствиеВидовОтпусковВозвратИзОУР = ПолучитьСоответствиеВидовОтпусковВозвратИзОУР();


	КонтекстЗагрузки = Новый Структура;
	КонтекстЗагрузки.Вставить("ОрганизацияСсылка", ОрганизацияСсылка);
	КонтекстЗагрузки.Вставить("ТекстДляРегистрацииОшибки", ТекстДляРегистрацииОшибки);
	КонтекстЗагрузки.Вставить("ЕстьОшибкиУровняНеОжидание", ЕстьОшибкиУровняНеОжидание);
	КонтекстЗагрузки.Вставить("Запросы", Запросы);
	КонтекстЗагрузки.Вставить("МассивДокументовОбъектов", Новый Массив);
	КонтекстЗагрузки.Вставить("СоответствиеВидовОтпусковВозвратИзОУР", СоответствиеВидовОтпусковВозвратИзОУР);

	СтруктураРаботаВВыходныеДни = Новый Структура; //+ КАБ кириллова 22.07.22
	первый=истина; //+ КАБ кириллова 22.07.22

	Для Каждого СоответствиеДанныхДокументовЭлемент Из СоответствиеДанныхДокументов Цикл
		КонтекстДокумента = Новый Структура;
		ОбработатьГруппуДокументовПакета(СоответствиеДанныхДокументовЭлемент, КонтекстДокумента, КонтекстЗагрузки);
	КонецЦикла;

	ТекстДляРегистрацииОшибки = КонтекстЗагрузки.ТекстДляРегистрацииОшибки;
	ЕстьОшибкиУровняНеОжидание = КонтекстЗагрузки.ЕстьОшибкиУровняНеОжидание;

	Возврат ЗаписатьДокументыОтпускаИзПакета(
		КонтекстЗагрузки.МассивДокументовОбъектов,
		ДокументДляЗагрузки,
		ТекстДляРегистрацииОшибки,
		ЕстьОшибкиУровняНеОжидание);

КонецФункции

