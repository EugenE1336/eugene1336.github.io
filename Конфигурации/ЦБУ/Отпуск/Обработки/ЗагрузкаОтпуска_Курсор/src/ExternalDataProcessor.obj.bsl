		Дети.Колонки.Добавить("Ребенок");
		Дети.Колонки.Добавить("ФамилияРебенка");
		Дети.Колонки.Добавить("ИмяРебенка");
		Дети.Колонки.Добавить("ОтчествоРебенка");
		Дети.Колонки.Добавить("ДатаРожденияРебенка");
		Дети.Колонки.Добавить("ВидДокументаРебенка");
		Дети.Колонки.Добавить("СерияДокумента");
		Дети.Колонки.Добавить("НомерДокумента");
