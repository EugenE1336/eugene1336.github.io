					ДокументОснование = СОКРЛП(ТекСтрокаЗначение.ДокументОснование);
				КонецЕсли;	
				ДокументОснованиеОУР = ДокументОснование + "_" + ФизическоеЛицоИД;
			КонецЕсли;	
			ВидОтпускаИД = СокрЛП(ТекСтрокаЗначение.ВидОтпускаФСС);
			
			//СтруктураСопоставленныйОбъект = РегистрыСведений.омСопоставлениеОбъектов.ПолучитьЗаписатьОбъект("Справочник.ВидыОтпусков", ВидОтпускаИД, "", Ложь, Ложь);
			//ВидОтпускаНаименованиеПолное = СтруктураСопоставленныйОбъект.ОбъектВнешнееНаименование;
			//ВидОтпускаНаименованиеПолное = СтрЗаменить(ВидОтпускаНаименованиеПолное, "   ", " ");
			//ВидОтпускаНаименованиеПолное = СтрЗаменить(ВидОтпускаНаименованиеПолное, "  ", " ");			
			
			лкМассивСтрокДанных = СоответствиеДанныхДокументов.Получить(ДокументИД);
			Если лкМассивСтрокДанных = Неопределено Тогда
				СоответствиеДанныхДокументов.Вставить(ДокументИД, Новый Массив);
			КонецЕсли;
			СоответствиеДанныхДокументов[ДокументИД].Добавить(ТекСтрокаЗначение);
			
		КонецЦикла;
		
	КонецЦикла;
	
	
	//Каб Куцеборский 20.03.23
	//////ДополнительнаяОбработкаОтпускаФСС (СоответствиеДанныхДокументов);
	//Каб Куцеборский 20.03.23
	
	Если ЕстьОшибкиУровняНеОжидание = Истина Тогда
		ВозврСтруктура = Новый Структура;
		ВозврСтруктура.Вставить("Статус", Перечисления.омСтатусыОчередиДанных.омОшибка);
		ВозврСтруктура.Вставить("ОписаниеОшибки", ТекстДляРегистрацииОшибки);
		Возврат ВозврСтруктура;
	КонецЕсли;
	
	Если СоответствиеДанныхДокументов.Количество() = 0 Тогда
		Возврат Истина; // пакет пустой, данных в нём нет
	КонецЕсли;
	
	// подготовим вспомогательные запросы
	
	ЗапросОсновногоПоказателя = Новый Запрос;
	ЗапросОсновногоПоказателя.Текст = "
	|ВЫБРАТЬ
	|	НачисленияПоказатели.Показатель КАК ПоказательСсылка
	|ИЗ
	|	ПланВидовРасчета.Начисления.Показатели КАК НачисленияПоказатели
	|ГДЕ
	|	НачисленияПоказатели.Ссылка = &НачислениеСсылка
	|	И НачисленияПоказатели.ОсновнойПоказатель = ИСТИНА
	|	";
	
	ЗапросДанныхВидаОтпуска = Новый Запрос;
	ЗапросДанныхВидаОтпуска.Текст = 
	"ВЫБРАТЬ
	|	ВидыОтпусков.ПредоставлятьОтпускВсемСотрудникам КАК ПредоставлятьОтпускВсемСотрудникам,
	|	ВидыОтпусков.ОтпускЯвляетсяЕжегодным КАК ОтпускЯвляетсяЕжегодным,
	|	ВидыОтпусков.ОтпускБезОплаты КАК ОтпускБезОплаты,
