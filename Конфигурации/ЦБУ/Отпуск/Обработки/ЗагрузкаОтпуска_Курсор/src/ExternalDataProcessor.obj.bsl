Функция ТаблицаСотрудников(Объект,ДатаСобытия)      // Объект.ДатаВозврата
	
	ВремяРегистрации = ЗарплатаКадрыРасширенный.ВремяРегистрацииДокумента(Объект.Ссылка, ДатаСобытия  );
	
	МассивСотрудников = КадровыйУчетРасширенный.МассивСотрудников(Объект.Сотрудник, Объект.Организация, ВремяРегистрации);
	
	ТаблицаСотрудников = Новый ТаблицаЗначений;
	ТаблицаСотрудников.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("СправочникСсылка.Сотрудники"));
	ТаблицаСотрудников.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблицаСотрудников.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
	ПериодПолученияНачислений = ВремяРегистрации;
	Для Каждого ЭлМассивСотрудников Из МассивСотрудников Цикл
		НоваяСтрокаТаблицаСотрудников = ТаблицаСотрудников.Добавить();
		НоваяСтрокаТаблицаСотрудников.Сотрудник = ЭлМассивСотрудников;
		НоваяСтрокаТаблицаСотрудников.Организация = Объект.Организация;
		НоваяСтрокаТаблицаСотрудников.Период = ПериодПолученияНачислений;
	КонецЦикла;  
	
	ПрочитатьДанныеСотрудников(ТаблицаСотрудников, ВремяРегистрации);
	
	Возврат ТаблицаСотрудников;
	
КонецФункции  


Процедура ПрочитатьДанныеСотрудников(ТаблицаСотрудников, ДатаСведений)   
	
	МассивСотрудников = ОбщегоНазначения.ВыгрузитьКолонку(ТаблицаСотрудников, "Сотрудник", Истина);
	
	СотрудникиДокумента = Новый ФиксированныйМассив(МассивСотрудников);
	
	СоответствиеДанныхСотрудников = Новый Соответствие;
	
	Если МассивСотрудников.Количество() > 0  Тогда
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Сотрудники.Сотрудник,
		|	ВЫРАЗИТЬ(Сотрудники.Должность КАК Справочник.Должности).ТарифнаяСетка КАК ТарифнаяСетка,
		|	ВЫРАЗИТЬ(Сотрудники.Должность КАК Справочник.Должности).РазрядКатегория КАК РазрядКатегория,
		|	ВЫРАЗИТЬ(Сотрудники.Должность КАК Справочник.Должности).ТарифнаяСеткаНадбавки КАК ТарифнаяСеткаНадбавки,
		|	Сотрудники.РазрядКатегория КАК РазрядКатегорияНадбавки
		|ИЗ
		|	ВТКадровыеДанныеСотрудников КАК Сотрудники";
		
		КадровыеДанные = "РазрядКатегория";
		
		КадровыеДанные = КадровыеДанные + ",Должность";
		
		
		КадровыйУчет.СоздатьНаДатуВТКадровыеДанныеСотрудников(
		Запрос.МенеджерВременныхТаблиц,
		Истина,
		МассивСотрудников,
		КадровыеДанные,
		ДатаСведений);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			ДанныеСотрудника = СтруктураОписанияДанныхСотрудника();
			ЗаполнитьЗначенияСвойств(ДанныеСотрудника, Выборка);
			
			СоответствиеДанныхСотрудников.Вставить(Выборка.Сотрудник, ДанныеСотрудника);
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	ДанныеСотрудников = Новый ФиксированноеСоответствие(СоответствиеДанныхСотрудников);
	
КонецПроцедуры   


Функция СтруктураОписанияДанныхСотрудника()
	
	СтруктураОписания = Новый Структура;
	СтруктураОписания.Вставить("ТарифнаяСетка", Справочники.ТарифныеСетки.ПустаяСсылка());
	СтруктураОписания.Вставить("РазрядКатегория", Справочники.РазрядыКатегорииДолжностей.ПустаяСсылка());
	СтруктураОписания.Вставить("ТарифнаяСеткаНадбавки", Справочники.ТарифныеСетки.ПустаяСсылка());
	СтруктураОписания.Вставить("РазрядКатегорияНадбавки", Справочники.РазрядыКатегорииДолжностей.ПустаяСсылка());
	
	Возврат СтруктураОписания;
	
КонецФункции


Процедура УдалитьОплатуПособийПоУходуЗаРебенкомИзРедактируемыхНачислений(Объект)
	
	Начисления = ОбщегоНазначения.ВыгрузитьКолонку(Объект.Начисления, "Начисление", Истина);
	КатегорииНачислений = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(Начисления, "КатегорияНачисленияИлиНеоплаченногоВремени");
	
	УдаляемыеСтроки = Новый Массив;
	Для Каждого Строка Из Объект.Начисления Цикл
		КатегорияНачисления = КатегорииНачислений[Строка.Начисление];
		Если КатегорияНачисления = Перечисления.КатегорииНачисленийИНеоплаченногоВремени.ПособиеПоУходуЗаРебенкомДоПолутораЛет
			Или КатегорияНачисления = Перечисления.КатегорииНачисленийИНеоплаченногоВремени.ПособиеПоУходуЗаРебенкомДоТрехЛет Тогда
			УдаляемыеСтроки.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Строка Из УдаляемыеСтроки Цикл
		Объект.Начисления.Удалить(Строка);
	КонецЦикла;
	
КонецПроцедуры


Функция ДатаКакЧисло(НекаяДата)
	
	Если НекаяДата = ДАТА(1,1,1) Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат ГОД(НекаяДата)*10000 + МЕСЯЦ(НекаяДата)*100 + ДЕНЬ(НекаяДата);
	
КонецФункции

// + КАБ Курсор 05.06.26 — рефакторинг ДополнительнаяОбработкаОтпуска


Функция МинимальнаяДатаНачалаОсновногоОтпуска(Строки)
	
	МинимальнаяДата = Дата(1, 1, 1);
	Для Каждого Строка Из Строки Цикл
		Если Строка.ДатаНачалаОсновногоОтпуска = Дата(1, 1, 1) Тогда
			Продолжить;
		КонецЕсли;
		Если МинимальнаяДата = Дата(1, 1, 1) Или Строка.ДатаНачалаОсновногоОтпуска < МинимальнаяДата Тогда
			МинимальнаяДата = Строка.ДатаНачалаОсновногоОтпуска;
		КонецЕсли;
	КонецЦикла;
	
	Возврат МинимальнаяДата;
	
КонецФункции


Функция МаксимальнаяДатаНачалаОсновногоОтпуска(Строки)
	
	МаксимальнаяДата = Дата(1, 1, 1);
	Для Каждого Строка Из Строки Цикл
		Если Строка.ДатаНачалаОсновногоОтпуска = Дата(1, 1, 1) Тогда
			Продолжить;
		КонецЕсли;
		Если МаксимальнаяДата = Дата(1, 1, 1) Или Строка.ДатаНачалаОсновногоОтпуска > МаксимальнаяДата Тогда
			МаксимальнаяДата = Строка.ДатаНачалаОсновногоОтпуска;
		КонецЕсли;
	КонецЦикла;
	
	Возврат МаксимальнаяДата;
	
КонецФункции


Функция МаксимальнаяДатаОкончанияОсновногоОтпуска(Строки)
	
	МаксимальнаяДата = Дата(1, 1, 1);
	Для Каждого Строка Из Строки Цикл
		Если Строка.ДатаОкончанияОсновногоОтпуска = Дата(1, 1, 1) Тогда
			Продолжить;
		КонецЕсли;
		Если МаксимальнаяДата = Дата(1, 1, 1) Или Строка.ДатаОкончанияОсновногоОтпуска > МаксимальнаяДата Тогда
			МаксимальнаяДата = Строка.ДатаОкончанияОсновногоОтпуска;
		КонецЕсли;
	КонецЦикла;
	
	Возврат МаксимальнаяДата;
	
КонецФункции


Функция ОтзывПолностьюСовпадаетСОтпуском(ОтпускИсправляемый, СтрокаОтзыва)
	
	Возврат СтрокаОтзыва.ДатаНачалаОсновногоОтпуска = ОтпускИсправляемый.ДатаНачалаОсновногоОтпуска
		И СтрокаОтзыва.ДатаОкончанияОсновногоОтпуска = ОтпускИсправляемый.ДатаОкончанияОсновногоОтпуска;
	
КонецФункции


Функция ОтзывСНачалаИсправляемогоОтпуска(ОтпускИсправляемый, Отзывы)
	
	МинимальнаяДатаНачалаОтзыва = МинимальнаяДатаНачалаОсновногоОтпуска(Отзывы);
	Возврат МинимальнаяДатаНачалаОтзыва = ОтпускИсправляемый.ДатаНачалаОсновногоОтпуска;
	
КонецФункции


Функция ОтзывСКонцаИсправляемогоОтпуска(ОтпускИсправляемый, Отзывы)
	
	МаксимальнаяДатаОкончанияОтзыва = МаксимальнаяДатаОкончанияОсновногоОтпуска(Отзывы);
	Возврат МаксимальнаяДатаОкончанияОтзыва = ОтпускИсправляемый.ДатаОкончанияОсновногоОтпуска;
	
КонецФункции


Процедура ПересчитатьКоличествоДнейСтрокиОтпуска(СтрокаОтпуска)
	
	Если СтрокаОтпуска.ДатаНачалаОсновногоОтпуска = Дата(1, 1, 1)
		Или СтрокаОтпуска.ДатаОкончанияОсновногоОтпуска = Дата(1, 1, 1) Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаОтпуска.КоличествоДнейОсновногоОтпуска = Строка(
		(СтрокаОтпуска.ДатаОкончанияОсновногоОтпуска - СтрокаОтпуска.ДатаНачалаОсновногоОтпуска) / 86400 + 1);
	
КонецПроцедуры


Процедура ЗаменитьМассивСтрокXDTO(МассивСтрокXDTO, НовыйСостав)
	
	Пока МассивСтрокXDTO.Количество() > 0 Цикл
		МассивСтрокXDTO.Удалить(МассивСтрокXDTO.ВГраница());
	КонецЦикла;
	
	Для Каждого СтрокаXDTO Из НовыйСостав Цикл
		МассивСтрокXDTO.Добавить(СтрокаXDTO);
	КонецЦикла;
	
КонецПроцедуры


Процедура УстановитьИтогОтзывИПредоставление(
	ЭлементДанных,
	МассивСтрокXDTO,
	СтрокаПредоставления,
	СтрокаОтзыва)
	
	СтрокаXDTOПредоставление = МассивСтрокXDTO[СтрокаПредоставления.НомерСтроки];
	СтрокаXDTOОтзыв = МассивСтрокXDTO[СтрокаОтзыва.НомерСтроки];
	ЗаполнитьЗначенияСвойств(СтрокаXDTOПредоставление, СтрокаПредоставления);
	ЗаполнитьЗначенияСвойств(СтрокаXDTOОтзыв, СтрокаОтзыва);
	ЗаписатьДатыСтрокиОтпускаВXDTO(
		СтрокаXDTOПредоставление,
		СтрокаПредоставления.ДатаНачалаОсновногоОтпуска,
		СтрокаПредоставления.ДатаОкончанияОсновногоОтпуска,
		СтрокаПредоставления.КоличествоДнейОсновногоОтпуска);
	ЗаписатьДатыСтрокиОтпускаВXDTO(
		СтрокаXDTOОтзыв,
		СтрокаОтзыва.ДатаНачалаОсновногоОтпуска,
		СтрокаОтзыва.ДатаОкончанияОсновногоОтпуска,
		СтрокаОтзыва.КоличествоДнейОсновногоОтпуска);
	
	НовыйСостав = Новый Массив;
	НовыйСостав.Добавить(СтрокаXDTOПредоставление);
	НовыйСостав.Добавить(СтрокаXDTOОтзыв);
	ЗаменитьМассивСтрокXDTO(ЭлементДанных.Значение, НовыйСостав);
	
КонецПроцедуры


Процедура СвернутьСмежныеДатыВМассиве(ЭлементДанных)
	
	МассивСтрокXDTO = ЭлементДанных.Значение;
	ТаблицаСтрок = СоздатьТаблицаОтпусковПоXDTO(МассивСтрокXDTO[0]);
	НомерСтроки = 0;
	
	Для Каждого СтрокаXDTO Из МассивСтрокXDTO Цикл
		ДатаНачала = ДатаИзСтрокиПакета(СтрокаXDTO.ДатаНачалаОсновногоОтпуска);
		ДатаОкончания = ДатаИзСтрокиПакета(СтрокаXDTO.ДатаОкончанияОсновногоОтпуска);
		Если ДатаНачала = Дата(1, 1, 1) Или ДатаОкончания = Дата(1, 1, 1) Тогда
			НомерСтроки = НомерСтроки + 1;
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаСтрок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаXDTO);
		НоваяСтрока.ДатаНачалаОсновногоОтпуска = ДатаНачала;
		НоваяСтрока.ДатаОкончанияОсновногоОтпуска = ДатаОкончания;
		НоваяСтрока.НомерСтроки = НомерСтроки;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	Если ТаблицаСтрок.Количество() < 2 Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаСтрок.Сортировать("ДатаНачалаОсновногоОтпуска Возр");
	МассивУдаления = Новый Массив;
	ПредСтрока = ТаблицаСтрок[0];
	СтрокаXDTO = МассивСтрокXDTO[ПредСтрока.НомерСтроки];
	
	Для Индекс = 1 По ТаблицаСтрок.ВГраница() Цикл
		ТекСтрока = ТаблицаСтрок[Индекс];
		СтрокаXDTOТек = МассивСтрокXDTO[ТекСтрока.НомерСтроки];
		
		Если СмежныеКалендарныеДни(ТекСтрока.ДатаНачалаОсновногоОтпуска, ПредСтрока.ДатаОкончанияОсновногоОтпуска) Тогда
			МассивУдаления.Добавить(ТекСтрока.НомерСтроки);
			СтрокаXDTO.ДатаОкончанияОсновногоОтпуска = СтрокаXDTOТек.ДатаОкончанияОсновногоОтпуска;
			ПредСтрока.ДатаОкончанияОсновногоОтпуска = ТекСтрока.ДатаОкончанияОсновногоОтпуска;
			СтрокаXDTO.КоличествоДнейОсновногоОтпуска = Строка(
				(ПредСтрока.ДатаОкончанияОсновногоОтпуска - ПредСтрока.ДатаНачалаОсновногоОтпуска) / 86400 + 1);
			ПредСтрока.КоличествоДнейОсновногоОтпуска = СтрокаXDTO.КоличествоДнейОсновногоОтпуска;
		Иначе
			ПредСтрока = ТекСтрока;
			СтрокаXDTO = СтрокаXDTOТек;
		КонецЕсли;
	КонецЦикла;
	
	УдалитьИндексыИзМассиваУбывающе(МассивСтрокXDTO, МассивУдаления);
	
КонецПроцедуры


Функция ПолучитьМассивДат(ДатаН, ДатаК)
	
	МассивДат = новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|   НАЧАЛОПЕРИОДА(&ДатаН, День) КАК День
	|УПОРЯДОЧИТЬ ПО
	|   День
	|ИТОГИ ПО
	|   День ПЕРИОДАМИ(ДЕНЬ, &ДатаН, &ДатаК)";
	
	Запрос.УстановитьПараметр("ДатаН", ДатаН);
	Запрос.УстановитьПараметр("ДатаК", ДатаК);
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "День", "ВСЕ");
	Пока Выборка.Следующий() Цикл
		МассивДат.Добавить(Выборка.День);
	КонецЦикла;
	
	Возврат  МассивДат;
	
КонецФункции 

