Процедура ИнициализироватьКонтекстГруппыДокументов(СоответствиеДанныхДокументовЭлемент, КонтекстДокумента)

	МассивРаботаВВыходныеДни = Новый Массив; //+ КАБ кириллова 22.07.22
	ЕстьОшибкиПоДокументу = Ложь;
	ДокументИД = СоответствиеДанныхДокументовЭлемент.Ключ;
	КонтекстДокумента.Вставить("ДокументИД", ДокументИД);
	
	МассивСтрокXDTO = СоответствиеДанныхДокументовЭлемент.Значение;
	КонтекстДокумента.Вставить("МассивСтрокXDTO", МассивСтрокXDTO);
	ТекСтрокаЗначение = МассивСтрокXDTO[0];
	НомерПриказа = СОКРЛП(ТекСтрокаЗначение.НомерПриказа);
	ДатаПриказаСтрока = СОКРЛП(ТекСтрокаЗначение.ДатаПриказа);
	//Сообщить(ДокументИД + " " + ТекСтрокаЗначение.Действие);
	Если ДатаПриказаСтрока = "" Тогда
		ДатаПриказа = НачалоДня(ТекущаяДата());  //+КАБ КИриллова 30.06.2022  
	Иначе
		ДатаПриказа = XMLЗначение(Тип("Дата"), ДатаПриказаСтрока);
	КонецЕсли; 
	//+КАБ КИриллова 30.06.2022
	Если ТекСтрокаЗначение.Свойства().Получить("Отработан")<> Неопределено Тогда
		ПериодРегистрацииСтрока = СОКРЛП(ТекСтрокаЗначение.Отработан);
		Если ПериодРегистрацииСтрока = "" Тогда
			ПериодРегистрации = НачалоМесяца(ТекущаяДата()); //ДатаПриказа
		Иначе
			ПериодРегистрации = НачалоМесяца(XMLЗначение(Тип("Дата"), ПериодРегистрацииСтрока));
		КонецЕсли;
	Иначе 
		ПериодРегистрации = НачалоМесяца(ТекущаяДата());
	КонецЕсли;
	// -КАБ КИриллова 30.06.2022
	ДокументДляЗагрузки = "Отпуск";
	СтруктураЗаполнения = Новый Структура;
	МассивДополнительныеОтпуска = Новый Массив;
	МассивДнейУхода = Новый Массив;   //+ КАБ Парамонов 12.07.22  
	ЕстьОшибкиПоДокументу = Ложь;
	БылПервыйДопОтп = Ложь; //+ КАБ Кириллова 24.06.22
	МассивДатОтзыва = Новый Массив;
	
	КонтекстДокумента.Вставить("МассивРаботаВВыходныеДни", МассивРаботаВВыходныеДни);
	КонтекстДокумента.Вставить("ЕстьОшибкиПоДокументу", ЕстьОшибкиПоДокументу);
	КонтекстДокумента.Вставить("НомерПриказа", НомерПриказа);
	КонтекстДокумента.Вставить("ДатаПриказа", ДатаПриказа);
	КонтекстДокумента.Вставить("ПериодРегистрации", ПериодРегистрации);
	КонтекстДокумента.Вставить("ДокументДляЗагрузки", ДокументДляЗагрузки);
	КонтекстДокумента.Вставить("СтруктураЗаполнения", СтруктураЗаполнения);
	КонтекстДокумента.Вставить("МассивДополнительныеОтпуска", МассивДополнительныеОтпуска);
	КонтекстДокумента.Вставить("МассивДнейУхода", МассивДнейУхода);
	КонтекстДокумента.Вставить("БылПервыйДопОтп", БылПервыйДопОтп);
	КонтекстДокумента.Вставить("МассивДатОтзыва", МассивДатОтзыва);

КонецПроцедуры

Функция ОбработатьСценарийПредоставитьОтозвать(КонтекстДокумента, КонтекстЗагрузки)

	ДокументИД = КонтекстДокумента.ДокументИД;
	ТекСтрокаЗначение = КонтекстДокумента.ТекСтрокаЗначение;
	ДокументДляЗагрузки = КонтекстДокумента.ДокументДляЗагрузки;
	ЭтоОтзыв = КонтекстДокумента.ЭтоОтзыв;
	МассивДатОтзыва = КонтекстДокумента.МассивДатОтзыва;
	ЕстьОшибкиПоДокументу = КонтекстДокумента.ЕстьОшибкиПоДокументу;

	СитуацияПредоставитьОтозвать = Ложь;
	Если ДокументИД = (ТекСтрокаЗначение.id + "_" + ТекСтрокаЗначение.сотрудник + "_01") тогда
		ДокументИД = СтрЗаменить(ДокументИД, "_01", "");
		СитуацияПредоставитьОтозвать = Истина;
	КонецЕсли;
	//Поиск загруженного ранее отпуска   
	ОтпускСсылка = Документы[ДокументДляЗагрузки].НайтиПоРеквизиту("омУИД", ДокументИД);
	
	Исправление = "";
	//Сообщить(ТекСтрокаЗначение.Действие);
	//+ КАБ Куцеборский 30.11.22
	ОтозватьПредоставить = Ложь;
	Если СитуацияПредоставитьОтозвать Тогда
		Если  Не ЗначениеЗаполнено(ОтпускСсылка) И ЭтоОтзыв Тогда
			//ОтпускОбъект = ОтпускСсылка.ПолучитьОбъект();
			ИндексМассива = 0;
			
			Для каждого Документ Из КонтекстЗагрузки.МассивДокументовОбъектов Цикл
				Если Строка(Документ.омУИД) = Строка(ДокументИД) Тогда
					ОтпускОбъект = Документ;
					ОтозватьПредоставить = Истина;
					Прервать;
				КонецЕсли;
				ИндексМассива = ИндексМассива + 1;
			КонецЦикла;
			Если ОтозватьПредоставить Тогда
				Попытка
					ОтпускОбъект.Записать(РежимЗаписиДокумента.Запись);
					СООБЩИТЬ("Записан: " + СТРОКА(ОтпускОбъект.Ссылка));
				Исключение
					КонтекстЗагрузки.ТекстДляРегистрацииОшибки = КонтекстЗагрузки.ТекстДляРегистрацииОшибки + ?(КонтекстЗагрузки.ТекстДляРегистрацииОшибки = "", "", Символы.ПС) + СтандартнаяСтрокаОшибки("Документ."+ДокументДляЗагрузки, ОтпускОбъект.омУИД, "НЕ ЗАПИСАН! " + ОписаниеОшибки());
				КонецПопытки;
				ОтпускОбъект.ПериодыПриостановкиОтпуска.Очистить();
				Для Каждого Запись Из МассивДатОтзыва Цикл
					
					//+ КАБ Куцеборский 01.11.22
					Период = ОтпускОбъект.ПериодыПриостановкиОтпуска.Добавить();
					Период.ДатаНачалаПериода = Запись.ДатаНачалаОсновногоОтпуска ;
					Период.ДатаОкончанияПериода = Запись.ДатаОкончанияОсновногоОтпуска;
					Период.КоличествоДнейПриостановки = Запись.КоличествоДнейОсновногоОтпуска;
					//-КАБ Куцеборский
					ОтпускОбъект.ДоначислитьЗарплатуПриНеобходимости = Истина;
					
				КонецЦикла;
				КонтекстЗагрузки.МассивДокументовОбъектов.Установить(ИндексМассива,ОтпускОбъект);
				Возврат Истина;
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(ОтпускСсылка) И ЭтоОтзыв Тогда
			ОтпускОбъект = ОтпускСсылка.ПолучитьОбъект();
			Если ОтпускОбъект.Проведен = Истина Тогда
				ОтпускИсправление = Документы[ДокументДляЗагрузки].СоздатьДокумент();
				ЗаполнитьЗначенияСвойств(ОтпускИсправление, ОтпускОбъект); 
				ОтпускИсправление.Организация = КонтекстЗагрузки.ОрганизацияСсылка;
				ОтпускИсправление.омУИД = ПолучитьСледующийУИД_ВСерии(ДокументДляЗагрузки,ДокументИД);
				ОтпускИсправление.Дата = НачалоДня(ТекущаяДата()); //+КАБ КИриллова 30.06.2022
				ОтпускИсправление.УстановитьНовыйНомер();
				ДанныеОтветственного = ПолучитьОтветственногоЗагрузкиДокументов(
					КонтекстЗагрузки.ТекстДляРегистрацииОшибки, КонтекстЗагрузки.ЕстьОшибкиУровняНеОжидание, ЕстьОшибкиПоДокументу);
				КонтекстЗагрузки.ТекстДляРегистрацииОшибки = ДанныеОтветственного.ТекстДляРегистрацииОшибки;
				КонтекстЗагрузки.ЕстьОшибкиУровняНеОжидание = ДанныеОтветственного.ЕстьОшибкиУровняНеОжидание;
				ЕстьОшибкиПоДокументу = ДанныеОтветственного.ЕстьОшибкиПоДокументу;
				Если ДанныеОтветственного.Успех Тогда
					ОтпускИсправление.Ответственный = ДанныеОтветственного.ПользовательОтветственный;
				Иначе
					Возврат Истина;
				КонецЕсли;
				
				ОтпускОбъект.ПериодыПриостановкиОтпуска.Очистить();
				Для Каждого Запись Из МассивДатОтзыва Цикл
					
					//+ КАБ Куцеборский 01.11.22
					Период = ОтпускОбъект.ПериодыПриостановкиОтпуска.Добавить();
					Период.ДатаНачалаПериода = Запись.ДатаНачалаОсновногоОтпуска ;
					Период.ДатаОкончанияПериода = Запись.ДатаОкончанияОсновногоОтпуска;
					Период.КоличествоДнейПриостановки = Запись.КоличествоДнейОсновногоОтпуска;
					//-КАБ Куцеборский
					ОтпускОбъект.ДоначислитьЗарплатуПриНеобходимости = Истина;
					
				КонецЦикла;
				КонтекстЗагрузки.МассивДокументовОбъектов.Добавить(ОтпускОбъект);
				Возврат Истина;
			КонецЕсли;
			
			
			Для Каждого Запись Из МассивДатОтзыва Цикл
				
				//+ КАБ Куцеборский 01.11.22
				Период = ОтпускОбъект.ПериодыПриостановкиОтпуска.Добавить();
				Период.ДатаНачалаПериода = Запись.ДатаНачалаОсновногоОтпуска ;
				Период.ДатаОкончанияПериода = Запись.ДатаОкончанияОсновногоОтпуска;
				Период.КоличествоДнейПриостановки = Запись.КоличествоДнейОсновногоОтпуска;
				//-КАБ Куцеборский
				ОтпускОбъект.ДоначислитьЗарплатуПриНеобходимости = Истина;
				
			КонецЦикла;
			КонтекстЗагрузки.МассивДокументовОбъектов.Добавить(ОтпускОбъект);
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	//- КАБ Куцеборский 30.11.22

	КонтекстДокумента.Вставить("ОтпускСсылка", ОтпускСсылка);
	КонтекстДокумента.Вставить("ДокументИД", ДокументИД);
	Возврат Ложь;

КонецФункции

Функция НайтиДокументИсправленияОтпуска(КонтекстДокумента, КонтекстЗагрузки)

	ДокументДляЗагрузки = КонтекстДокумента.ДокументДляЗагрузки;
	ИсправлениеИД = КонтекстДокумента.ИсправлениеИД;
	ФизЛицоИД = КонтекстДокумента.ФизЛицоИД;
	СотрудникИД = КонтекстДокумента.СотрудникИД;
	ЭтоВозвратИзОУР = КонтекстДокумента.ЭтоВозвратИзОУР;
	ЭтоОтзыв = КонтекстДокумента.ЭтоОтзыв;
	ОтпускСсылка = КонтекстДокумента.ОтпускСсылка;
	ДокументИД = КонтекстДокумента.ДокументИД;
	СотрудникСсылка = КонтекстДокумента.СотрудникСсылка;
	НомерПриказа = КонтекстДокумента.НомерПриказа;
	ДатаПриказа = КонтекстДокумента.ДатаПриказа;
	ЕстьОшибкиПоДокументу = КонтекстДокумента.ЕстьОшибкиПоДокументу;
	СтруктураЗаполнения = КонтекстДокумента.СтруктураЗаполнения;
	Результат = Новый Структура;
	Результат.Вставить("Исправление", "");
	Результат.Вставить("ИсправлениеФизлицо", "");
	Результат.Вставить("ИсправлениеСотрудник", "");
	Результат.Вставить("Обработано", Ложь);
	Исправление = "";
	ИсправлениеФизлицо = "";
	ИсправлениеСотрудник = "";

	Если ЭтоВозвратИзОУР и ИсправлениеИД <> "" Тогда
		ИсправлениеФизлицо = ИсправлениеИД + "_" + ФизЛицоИД;
		ИсправлениеСотрудник = ИсправлениеИД + "_" + СотрудникИД;
		Исправление = Документы.ОтпускПоУходуЗаРебенком.НайтиПоРеквизиту("омУИД", ИсправлениеФизлицо);
		Если НЕ ЗначениеЗаполнено(Исправление) Тогда
			Исправление = Документы.ОтпускПоУходуЗаРебенком.НайтиПоРеквизиту("омУИД", ИсправлениеСотрудник);
		КонецЕсли;
	Иначе 
		ИсправлениеФизлицо = ИсправлениеИД + "_" + ФизЛицоИД;
		ИсправлениеСотрудник = ИсправлениеИД + "_" + СотрудникИД;
		Исправление = Документы[ДокументДляЗагрузки].НайтиПоРеквизиту("омУИД", ИсправлениеФизлицо);
		Если НЕ ЗначениеЗаполнено(Исправление) Тогда
			Исправление = Документы[ДокументДляЗагрузки].НайтиПоРеквизиту("омУИД", ИсправлениеСотрудник);
		КонецЕсли;
	КонецЕсли;
	
	
	//+ КАБ Куцеборский 06.09.22
	Если ЭтоОтзыв и НЕ ЗначениеЗаполнено(Исправление) Тогда
		////КонтекстЗагрузки.ТекстДляРегистрацииОшибки = КонтекстЗагрузки.ТекстДляРегистрацииОшибки + "Не найден отзываемый отпуск";
		////КонтекстЗагрузки.ЕстьОшибкиУровняНеОжидание = Истина;
		Если ЗначениеЗаполнено(ОтпускСсылка) Тогда
			ОтпускОбъект = ОтпускСсылка.ПолучитьОбъект();
			Если ОтпускОбъект.Проведен = Истина Тогда
				ОтпускИсправление = Документы[ДокументДляЗагрузки].СоздатьДокумент();
				ЗаполнитьЗначенияСвойств(ОтпускИсправление, ОтпускОбъект);
				ОтпускИсправление.омУИД = ПолучитьСледующийУИД_ВСерии(ДокументДляЗагрузки,ДокументИД);
				ОтпускИсправление.Дата = НачалоДня(ТекущаяДата()); //+КАБ КИриллова 30.06.2022
				ОтпускИсправление.УстановитьНовыйНомер();
			Иначе
				ОтпускИсправление = ОтпускОбъект;
				ОтпускИсправление.омУИД = ДокументИД;
				ОтпускИсправление.Дата = НачалоДня(ТекущаяДата()); //+КАБ КИриллова 30.06.2022
			КонецЕсли;	
		Иначе
			ОтпускИсправление = Документы[ДокументДляЗагрузки].СоздатьДокумент();
			ОтпускИсправление.омУИД = ПолучитьСледующийУИД_ВСерии(ДокументДляЗагрузки,ДокументИД);
			ОтпускИсправление.Дата = НачалоДня(ТекущаяДата()); //+КАБ КИриллова 30.06.2022
			ОтпускИсправление.УстановитьНовыйНомер();
		КонецЕсли;
			
		//ЗаполнитьЗначенияСвойств(ОтпускИсправление, ОтпускОбъект,"Сотрудник"); 
		ОтпускИсправление.Сотрудник = СотрудникСсылка;
		ОтпускИсправление.Организация = КонтекстЗагрузки.ОрганизацияСсылка;
		ОтпускИсправление.Дата = НачалоДня(ТекущаяДата()); //+КАБ КИриллова 30.06.2022
		ОтпускИсправление.ПериодРегистрации = НачалоМесяца(ТекущаяДата());
		Если ДокументДляЗагрузки = "ОтпускБезСохраненияОплаты" Тогда
			ОтпускИсправление.ДатаНачала = Дата(1,1,1);
			ОтпускИсправление.ДатаОкончания = Дата(1,1,1);
		Иначе
			ОтпускИсправление.ДатаНачалаОсновногоОтпуска = Дата(1,1,1);
			ОтпускИсправление.ДатаОкончанияОсновногоОтпуска = Дата(1,1,1);
		КонецЕсли;
		ДанныеОтветственного = ПолучитьОтветственногоЗагрузкиДокументов(
			КонтекстЗагрузки.ТекстДляРегистрацииОшибки, КонтекстЗагрузки.ЕстьОшибкиУровняНеОжидание, ЕстьОшибкиПоДокументу);
		КонтекстЗагрузки.ТекстДляРегистрацииОшибки = ДанныеОтветственного.ТекстДляРегистрацииОшибки;
		КонтекстЗагрузки.ЕстьОшибкиУровняНеОжидание = ДанныеОтветственного.ЕстьОшибкиУровняНеОжидание;
		ЕстьОшибкиПоДокументу = ДанныеОтветственного.ЕстьОшибкиПоДокументу;
		Если ДанныеОтветственного.Успех Тогда
			ОтпускИсправление.Ответственный = ДанныеОтветственного.ПользовательОтветственный;
		Иначе
			Результат.Обработано = Истина;
			Возврат Результат;
		КонецЕсли;
		ОтпускИсправление.Комментарий = "Не найден исправляемый документ|Загружено из Парус " + СТРОКА(ТекущаяДата()) + ", номер приказа " + НомерПриказа + " от " + ФОРМАТ(ДатаПриказа, "ДФ=""дд.ММ.гггг""");
		КонтекстЗагрузки.МассивДокументовОбъектов.Добавить(ОтпускИсправление);
		Результат.Обработано = Истина;
		Возврат Результат;
	ИначеЕсли  ЗначениеЗаполнено(Исправление) Тогда 
		СтруктураЗаполнения.Вставить("ИсправленныйДокумент",Исправление);
	КонецЕсли;	
	//- КАБ Куцеборский	
	//////Курильская 26.05.21

	Результат.Исправление = Исправление;
	Результат.ИсправлениеФизлицо = ИсправлениеФизлицо;
	Результат.ИсправлениеСотрудник = ИсправлениеСотрудник;
	Возврат Результат;

КонецФункции

Функция ПолучитьИлиСоздатьОбъектОтпуска(КонтекстДокумента, КонтекстЗагрузки, Исправление)

	ОтпускСсылка = КонтекстДокумента.ОтпускСсылка;
	ДокументДляЗагрузки = КонтекстДокумента.ДокументДляЗагрузки;
	ДействиеДокумента = КонтекстДокумента.ДействиеДокумента;
	СтруктураЗаполнения = КонтекстДокумента.СтруктураЗаполнения;
	ИсправлениеОт = КонтекстДокумента.ИсправлениеОт;
	НомерПриказа = КонтекстДокумента.НомерПриказа;
	ДатаПриказа = КонтекстДокумента.ДатаПриказа;
	ДокументИД = КонтекстДокумента.ДокументИД;
	ПериодРегистрации = КонтекстДокумента.ПериодРегистрации;
	МассивДополнительныеОтпуска = КонтекстДокумента.МассивДополнительныеОтпуска;
	ЕстьОшибкиПоДокументу = КонтекстДокумента.ЕстьОшибкиПоДокументу;
	ЭтоСанКур = КонтекстДокумента.ЭтоСанКур;
	ЭтоРаботаВВыходныеДни = КонтекстДокумента.ЭтоРаботаВВыходныеДни;
	ЭтоВозвратИзОУР = КонтекстДокумента.ЭтоВозвратИзОУР;
	ЭтоОтпускПоУходуЗаРебенком_15 = КонтекстДокумента.ЭтоОтпускПоУходуЗаРебенком_15;
	ЭтоОтпускПоУходуЗаРебенком_3 = КонтекстДокумента.ЭтоОтпускПоУходуЗаРебенком_3;
	ЭтоОтпускБезСохраненияОплаты = КонтекстДокумента.ЭтоОтпускБезСохраненияОплаты;
	ЭтоОтпускПоУходуЗаДетьмиИнвалидами = КонтекстДокумента.ЭтоОтпускПоУходуЗаДетьмиИнвалидами;
	ЭтоОплатаПоСреднемуЗаработку = КонтекстДокумента.ЭтоОплатаПоСреднемуЗаработку;
	Результат = Новый Структура;
	Результат.Вставить("ОтпускОбъект", Неопределено);
	Результат.Вставить("Обработано", Ложь);

	//Если НЕ ЗначениеЗаполнено(ОтпускСсылка) И ДействиеДокумента = "Продлить" И (ДокументДляЗагрузки="Отпуск" ИЛИ ДокументДляЗагрузки="ОтпускБезСохраненияОплаты") Тогда
	// теперь требуется продление только документа Отпуск
	Если НЕ ЗначениеЗаполнено(ОтпускСсылка) И ДействиеДокумента = "Продлить" И ДокументДляЗагрузки="Отпуск" Тогда
		//в вызываемой функции выполняется поиск документа по указанным параметрам
		//если документ для исправления подбирается, то в функции выполняется создание его копии и дозаполнение нужных реквизитов
		
		ОтпускОбъект = ПодобратьОтпускДляПродления(СтруктураЗаполнения, ДокументДляЗагрузки, ИсправлениеОт, НомерПриказа, ДатаПриказа, документИД, ПериодРегистрации, КонтекстЗагрузки.ОрганизацияСсылка);
		//если документ, на основе которого должно быть выполнено продление, не найден,
		//выполняется создание нового документа по существующим правилам
		//Сообщить(ОтпускОбъект);
		Если ОтпускОбъект = Документы[ДокументДляЗагрузки].ПустаяСсылка() Тогда
			
			//Создание документа
			ОтпускОбъект = Документы[ДокументДляЗагрузки].СоздатьДокумент();
			ОтпускОбъект.Организация = КонтекстЗагрузки.ОрганизацияСсылка;
			ОтпускОбъект.омУИД = ДокументИД;
			ОтпускОбъект.Дата = НачалоДня(ТекущаяДата()); //+КАБ КИриллова 30.06.2022
			ОтпускОбъект.УстановитьНовыйНомер();
			ДанныеОтветственного = ПолучитьОтветственногоЗагрузкиДокументов(
				КонтекстЗагрузки.ТекстДляРегистрацииОшибки, КонтекстЗагрузки.ЕстьОшибкиУровняНеОжидание, ЕстьОшибкиПоДокументу);
			КонтекстЗагрузки.ТекстДляРегистрацииОшибки = ДанныеОтветственного.ТекстДляРегистрацииОшибки;
			КонтекстЗагрузки.ЕстьОшибкиУровняНеОжидание = ДанныеОтветственного.ЕстьОшибкиУровняНеОжидание;
			ЕстьОшибкиПоДокументу = ДанныеОтветственного.ЕстьОшибкиПоДокументу;
			Если ДанныеОтветственного.Успех Тогда
				ОтпускОбъект.Ответственный = ДанныеОтветственного.ПользовательОтветственный;
			Иначе
				Результат.Обработано = Истина;
				Возврат Результат;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(ОтпускОбъект, СтруктураЗаполнения); 
			ОтпускОбъект.ПериодРегистрации = ПериодРегистрации;
			ОтпускОбъект.Комментарий = "Загружено из Парус " + СТРОКА(ТекущаяДата()) + ", номер приказа " + НомерПриказа + " от " + ФОРМАТ(ДатаПриказа, "ДФ=""дд.ММ.гггг""");
			
			Если ДокументДляЗагрузки = "Отпуск" Тогда
				ОтпускОбъект.ДополнительныеОтпуска.Очистить();
				Для Каждого СтруктураДополнительныйОтпуск Из МассивДополнительныеОтпуска Цикл
					СтрокаДополнительныйОтпуск = ОтпускОбъект.ДополнительныеОтпуска.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаДополнительныйОтпуск, СтруктураДополнительныйОтпуск); 
				КонецЦикла;	
				//+КабКириллова 240722
			ИначеЕсли ДокументДляЗагрузки = "РаботаВВыходныеИПраздничныеДни" Тогда
				ОтпускОбъект.Причина = НомерПриказа;
				ОтпускОбъект.ВремяВЧасах=Ложь;
				ОтпускОбъект.СогласиеТребуется = Истина; 
				ОтпускОбъект.СогласиеПолучено = Истина;
				//ОтпускОбъект.ВремяУчтено = Истина;
				//-Каб Кириллова
				//	//(+)Сапрыкин	 
				//ИначеЕсли ДокументДляЗагрузки = "Отгул" тогда	 			 
				//	
				//	ОтпускОбъект.Заполнить(СтруктураЗаполнения.Сотрудник);
				//	ОтпускОбъект.омУИД = ДокументИД;
				//	
				//	ОтпускОбъект.КоличествоДнейОтгула 	= (НачалоДня(ДатаОкончанияОсновногоОтпуска) - НачалоДня(ДатаНачалаОсновногоОтпуска)) / (60 * 60 * 24);
				//	
				//	ОтпускОбъект.ДатаНачала 			= ДатаНачалаОсновногоОтпуска;
				//	ОтпускОбъект.ДатаОкончания 		= ДатаОкончанияОсновногоОтпуска;						
				//	ОтпускОбъект.ПериодРегистрации 	= ПериодРегистрации						
