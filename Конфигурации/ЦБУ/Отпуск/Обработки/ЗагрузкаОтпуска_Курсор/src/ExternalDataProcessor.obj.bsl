		КонецЕсли; 
		ПериодРегистрации = НачалоМесяца(ДатаНачала);
		//////КонецЕсли;
		// -КАБ КИриллова 30.06.2022
		СтруктураЗаполнения = Новый Структура;		
		Дети = Новый ТаблицаЗначений;
