		Если ЕстьОшибкиУровняНеОжидание = Истина Тогда
			СООБЩИТЬ(ТекстДляРегистрацииОшибки);
			ВозврСтруктура = Новый Структура;
			ВозврСтруктура.Вставить("Статус", Перечисления.омСтатусыОчередиДанных.омОшибка);
			ВозврСтруктура.Вставить("ОписаниеОшибки", ТекстДляРегистрацииОшибки);
			Возврат ВозврСтруктура;
		Иначе
			ВозврСтруктура = Новый Структура;
			ВозврСтруктура.Вставить("Статус", Перечисления.омСтатусыОчередиДанных.омОжидание);
			ВозврСтруктура.Вставить("ОписаниеОшибки", ТекстДляРегистрацииОшибки);
			Возврат ВозврСтруктура;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Истина;	
	
КонецФункции


Функция ПолучитьСледующийУИД_ВСерии(ВидДокумента, омУИД)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("омУИД", омУИД);
	Запрос.УстановитьПараметр("СтрокаУИД", омУИД + "%");
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Отпуск.омУИД КАК омУИД
	|ИЗ
	|	Документ." + ВидДокумента + "  КАК Отпуск
	|ГДЕ
	|	Отпуск.омУИД ПОДОБНО &омУИД
	|	ИЛИ Отпуск.омУИД ПОДОБНО &СтрокаУИД
	|
	|УПОРЯДОЧИТЬ ПО
	|	омУИД УБЫВ";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат омУИД;
	КонецЕсли;
	
	ВыборкаЗапроса = РезультатЗапроса.Выбрать();
	ВыборкаЗапроса.Следующий();
	ПоследнийУИД = СОКРЛП(ВыборкаЗапроса.омУИД);
	Последние4 = ПРАВ(ПоследнийУИД, 4);
	Если ЛЕВ(Последние4, 1) <> "_" Тогда
		Возврат ПоследнийУИД + "_001";
	КонецЕсли;
	
	ЧисловаяЧастьСтрока = ПРАВ(Последние4, 3);
	Если ЛЕВ(ЧисловаяЧастьСтрока, 3) = "000" Тогда
		Возврат ПоследнийУИД + "_001";
	Иначе
		Если ЛЕВ(ЧисловаяЧастьСтрока, 2) = "00" Тогда
			СобственноЧисловаяЧастьСтрока = ПРАВ(ЧисловаяЧастьСтрока, 1);
		ИначеЕсли ЛЕВ(ЧисловаяЧастьСтрока, 1) = "0" Тогда
			СобственноЧисловаяЧастьСтрока = ПРАВ(ЧисловаяЧастьСтрока, 2);
		Иначе
			СобственноЧисловаяЧастьСтрока = ЧисловаяЧастьСтрока;
		КонецЕсли;
		ЧисловаяЧастьСледующий = ЧИСЛО(СобственноЧисловаяЧастьСтрока) + 1;
		Если ЧисловаяЧастьСледующий > 99 Тогда
			Возврат ПоследнийУИД + "_" + СОКРЛП(ЧисловаяЧастьСледующий);
		ИначеЕсли ЧисловаяЧастьСледующий > 9 Тогда
			Возврат ПоследнийУИД + "_0" + СОКРЛП(ЧисловаяЧастьСледующий);
		Иначе
			Возврат ПоследнийУИД + "_00" + СОКРЛП(ЧисловаяЧастьСледующий);
		КонецЕсли;
	КонецЕсли;
	
КонецФункции


Функция ПолучитьВидДоговораДляДолжности(ДолжностьСсылка);
	ВидДоговораДляДокумента = Перечисления.ВидыДоговоровССотрудниками.КонтрактГосслужащего;
	
	Запрос = Новый Запрос ("ВЫБРАТЬ
	|	СвойстваДолжностейГосударственнойСлужбы.Должность КАК Должность,
	|	СвойстваДолжностейГосударственнойСлужбы.ВидДолжностиГосударственнойСлужбы КАК ВидДолжностиГосударственнойСлужбы
	|ИЗ
	|	РегистрСведений.СвойстваДолжностейГосударственнойСлужбы КАК СвойстваДолжностейГосударственнойСлужбы
	|ГДЕ
	|	СвойстваДолжностейГосударственнойСлужбы.Должность = &Должность");
	Запрос.УстановитьПараметр("Должность",ДолжностьСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() ТОгда
		ВидДолжностиИзРегистра = Выборка.ВидДолжностиГосударственнойСлужбы;
		Если ВидДолжностиИзРегистра = Перечисления.ВидыДолжностейГосударственнойСлужбы.НеЯвляетсяДолжностьюГосударственнойСлужбы Тогда
			ВидДоговораДляДокумента = Перечисления.ВидыДоговоровССотрудниками.ТрудовойДоговор;
		КонецЕсли;		
	КонецЕсли;
	Возврат ВидДоговораДляДокумента;
	
КонецФункции


Функция ОпределитьЗначениеПеречисления(НашеПеречисление, ЗначениеСтрока);
	
	Если НашеПеречисление = Перечисления.ВидыЗанятости Тогда
		Возврат Перечисления.ВидыЗанятости.ОсновноеМестоРаботы;
	КонецЕсли;
	
	ЗначениеПакета = СокрЛП(ЗначениеСтрока);
	Список = Новый СписокЗначений;	
	Для Каждого Зн Из НашеПеречисление Цикл
		Список.Добавить(Зн);
	КонецЦикла;
	
	Для Каждого ЗначенияП из Список Цикл
		ЗначенияПСтрокой = Строка(ЗначенияП.Значение);
		ПервыеБуквыПакета  = Лев(НРег(ЗначениеПакета),5);
		ПервыеБуквыПеречисления = Лев(НРег(ЗначенияПСтрокой),5);
		Если ПервыеБуквыПакета = ПервыеБуквыПеречисления тогда
			
			Возврат ЗначенияП.Значение;	
		КонецЕсли;
		
	КонецЦикла;
	//Возврат РеквизитПоУмолчанию; 
КонецФункции


Процедура ПроверкаНаличияФайлов(Документ)
	Документ = Документ.Ссылка;
	Сообщить("Тип документа: " + ТипЗнч(Документ));
	РегистрФайлов = РегистрыСведений.НаличиеФайлов.СоздатьМенеджерЗаписи();
	РегистрФайлов.ОбъектСФайлами = Документ;
	РегистрФайлов.Прочитать();
	Если НЕ РегистрФАйлов.Выбран() Тогда
		РегистрФайлов.ОбъектСФайлами = Документ;
		РегистрФайлов.ЕстьФайлы = Истина;
		РегистрФайлов.Записать();
	Иначе
		Если РегистрФайлов.ЕстьФайлы = Ложь Тогда
			РегистрФайлов.ЕстьФайлы = Истина;
			РегистрФайлов.Записать(Истина);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
