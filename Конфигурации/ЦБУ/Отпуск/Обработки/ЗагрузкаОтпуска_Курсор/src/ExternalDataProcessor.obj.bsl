	МетаданныеФизЛица = Справочники.омМетаданныеИС.НайтиПоНаименованию("Физические Лица");
	МетаданныеДолжности = Справочники.омМетаданныеИС.НайтиПоНаименованию("Должности");
	МетаданныеГрафика = Справочники.омМетаданныеИС.НайтиПоНаименованию("Графики работы сотрудников");
	МетаданныеПриема = Справочники.омМетаданныеИС.НайтиПоНаименованию("Прием на работу");
	МетаданныеШтатки = Справочники.омМетаданныеИС.НайтиПоНаименованию("Штатное расписание");
	МетаданныеНачислений = Справочники.омМетаданныеИС.НайтиПоНаименованию("Начисления");
	
	ЕстьОшибкиУровняНеОжидание = Ложь;
	
	ЕСли ТипЗнч(ПакетОбъектXDTO.ОтпускаФСС) = Тип("ОбъектXDTO") ТОгда
		ДанныеПакета = Новый Массив;
		ДанныеПакета.Добавить(ПакетОбъектXDTO.ОтпускаФСС);
	Иначе
		ДанныеПакета = ПакетОбъектXDTO.ОтпускаФСС;
	КонецЕсли;
	
	
	СоответствиеДанныхДокументов = Новый Соответствие;
	//////СоответствиеПропускаемыхВидовОтпусков = ПолучитьСоответствиеПропускаемыхВидовОтпусков();   
	//////СоответствиеВидовОтпусковВозвратИзОУР = ПолучитьСоответствиеВидовОтпусковВозвратИзОУР();
	
	Для Каждого ТекущаяСтрока ИЗ ДанныеПакета Цикл
		
		Если ТекущаяСтрока.Свойства().Получить("ОтпускФСС") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(ТекущаяСтрока.ОтпускФСС) = Тип("ОбъектXDTO") Тогда
			Данные = Новый Массив;
			Данные.Добавить(ТекущаяСтрока.ОтпускФСС);
		Иначе
			Данные = ТекущаяСтрока.ОтпускФСС;
		КонецЕсли;
		
		Для Каждого ТекСтрокаЗначение Из Данные Цикл
			ПриказИД = СОКРЛП(ТекСтрокаЗначение.ID);
			ФизическоеЛицоИД = СОКРЛП(ТекСтрокаЗначение.ФизическоеЛицо);
			Если СокрЛП(ТекСтрокаЗначение.видзаболевания = "ОУР 1,5") Тогда
				Приписка = "15"
			ИначеЕсли  СокрЛП(ТекСтрокаЗначение.видзаболевания = "ОУР 3") Тогда
