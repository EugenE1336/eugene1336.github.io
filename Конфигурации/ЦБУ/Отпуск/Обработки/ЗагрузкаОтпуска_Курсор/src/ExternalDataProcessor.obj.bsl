Функция ПодобратьОтпускДляПродления(СтруктураЗаполнения, ДокументДляЗагрузки, ИсправлениеОт, НомерПриказа, ДатаПриказа, ДокументИД, ПериодРегистрации, ОрганизацияСсылка)
	
	//СООБЩИТЬ("Ищем документ для строки с ИД = " + ДокументИД);
	
	НайденныйОтпуск = Документы[ДокументДляЗагрузки].ПустаяСсылка();
	
	Если ДокументДляЗагрузки = "Отпуск" Тогда
		Если СтруктураЗаполнения.ПредоставитьОсновнойОтпуск Тогда
			
			Запрос = Новый Запрос("ВЫБРАТЬ
			|	Отпуск.ФизическоеЛицо КАК ФизическоеЛицо,
			|	Отпуск.Сотрудник КАК Сотрудник,
			|	Отпуск.Ссылка КАК Ссылка,
			|	Отпуск.ДатаНачалаОсновногоОтпуска КАК ДатаНачалаОсновногоОтпуска
			|ИЗ
			|	Документ.Отпуск КАК Отпуск
			|ГДЕ
			|	Отпуск.ФизическоеЛицо = &ФизическоеЛицо
			|	И Отпуск.Сотрудник = &Сотрудник
			|	И Отпуск.ПометкаУдаления = ЛОЖЬ
			//|	И Отпуск.ДатаНачалаОсновногоОтпуска = &ДатаНачалаОсновногоОтпуска
			|
			|УПОРЯДОЧИТЬ ПО 
			|	Отпуск.Дата УБЫВ
			|
			|");
			
			Запрос.УстановитьПараметр("ФизическоеЛицо",СтруктураЗаполнения.ФизическоеЛицо);
			Запрос.УстановитьПараметр("Сотрудник",СтруктураЗаполнения.Сотрудник);
			//Запрос.УстановитьПараметр("ДатаНачалаОсновногоОтпуска",ИсправлениеОт);
			
			Результат = Запрос.Выполнить();
			Выборка = Результат.Выбрать();
			Если Выборка.Следующий() Тогда
				НайденныйОтпуск = Выборка.Ссылка;
			КонецЕсли;
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(НайденныйОтпуск) И СтруктураЗаполнения.ПредоставитьДополнительныйОтпуск Тогда
			
			МассивДополнительныеОтпуска = СтруктураЗаполнения.МассивДополнительныеОтпуска;
			МассивВидыОтпусков = Новый Массив;
			Для Каждого СтруктураДополнительныйОтпуск Из МассивДополнительныеОтпуска Цикл
				МассивВидыОтпусков.Добавить(СтруктураДополнительныйОтпуск.ВидОтпуска);
			КонецЦикла;
			
			Запрос = Новый Запрос("ВЫБРАТЬ
			|	ОтпускДополнительныеОтпуска.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.Отпуск.ДополнительныеОтпуска КАК ОтпускДополнительныеОтпуска
			|ГДЕ
			//|	ОтпускДополнительныеОтпуска.ВидОтпуска = &ВидОтпуска
			|	ОтпускДополнительныеОтпуска.ВидОтпуска В(&МассивВидыОтпусков)
			|	И ОтпускДополнительныеОтпуска.Ссылка.ФизическоеЛицо = &ФизическоеЛицо
			|	И ОтпускДополнительныеОтпуска.Ссылка.Сотрудник = &Сотрудник
			|	И ОтпускДополнительныеОтпуска.Ссылка.ПометкаУдаления = ЛОЖЬ
			//|	И ОтпускДополнительныеОтпуска.ДатаНачала = &ДатаНачала
			|
			|УПОРЯДОЧИТЬ ПО 
			|	ОтпускДополнительныеОтпуска.Ссылка.Дата УБЫВ
			|");
			
			Запрос.УстановитьПараметр("ВидОтпуска", СтруктураЗаполнения.ВидОтпуска);
			Запрос.УстановитьПараметр("МассивВидыОтпусков", МассивВидыОтпусков);
			Запрос.УстановитьПараметр("ФизическоеЛицо", СтруктураЗаполнения.ФизическоеЛицо);
			Запрос.УстановитьПараметр("Сотрудник", СтруктураЗаполнения.Сотрудник);
			//Запрос.УстановитьПараметр("ДатаНачала",ИсправлениеОт);
			
			Результат = Запрос.Выполнить();
			Выборка = Результат.Выбрать();
			Если Выборка.Следующий() Тогда
				НайденныйОтпуск = Выборка.Ссылка;
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ДокументДляЗагрузки = "ОтпускБезСохраненияОплаты" Тогда
		Запрос = новый Запрос("ВЫБРАТЬ
		|	ОтпускБезСохраненияОплаты.Сотрудник КАК Сотрудник,
		|	ОтпускБезСохраненияОплаты.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ОтпускБезСохраненияОплаты.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ОтпускБезСохраненияОплаты КАК ОтпускБезСохраненияОплаты
		|ГДЕ
		|	ОтпускБезСохраненияОплаты.ФизическоеЛицо = &ФизическоеЛицо
		|	И ОтпускБезСохраненияОплаты.ВидОтпуска = &ВидОтпуска
		|	И ОтпускБезСохраненияОплаты.Сотрудник = &Сотрудник
		|	И ОтпускБезСохраненияОплаты.ПометкаУдаления = ЛОЖЬ
		//|	И ОтпускБезСохраненияОплаты.ДатаНачала = &ДатаНачала
		|
		|УПОРЯДОЧИТЬ ПО 
		|	ОтпускБезСохраненияОплаты.Дата УБЫВ
		|");
		
		Запрос.УстановитьПараметр("ВидОтпуска",СтруктураЗаполнения.ВидОтпуска);
		Запрос.УстановитьПараметр("ФизическоеЛицо",СтруктураЗаполнения.ФизическоеЛицо);
		Запрос.УстановитьПараметр("Сотрудник",СтруктураЗаполнения.Сотрудник);
		//Запрос.УстановитьПараметр("ДатаНачала",ИсправлениеОт);
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		Если Выборка.Следующий() Тогда
			НайденныйОтпуск = Выборка.Ссылка;
		КонецЕсли;
	Иначе
		Возврат НайденныйОтпуск;
	КонецЕсли;
	
	//Если ЗначениеЗаполнено(НайденныйОтпуск) Тогда
	//	СООБЩИТЬ(СТРОКА(НайденныйОтпуск));
	//Иначе
	//	СООБЩИТЬ("Документ не найден");
	//КонецЕсли;
	
	//ищем последний документ в цепочке
	ЗапросДокументаИсправления = Новый Запрос;
	ТекстЗапросаОтпуск = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	НужныйДокумент.Ссылка КАК ДокументСсылка
	|ИЗ
	|	Документ.Отпуск КАК НужныйДокумент
	|ГДЕ
	|	НужныйДокумент.ПометкаУдаления <> ИСТИНА
	|	И НужныйДокумент.ИсправленныйДокумент = &ИсправленныйДокумент
	|	";
	ЗапросДокументаИсправления.Текст = ТекстЗапросаОтпуск;
	
	ДокументСсылка = НайденныйОтпуск;
	КоличествоПовторов = 0;
	лкТекстЗапросаОтпуск = СтрЗаменить(ТекстЗапросаОтпуск, "Документ.Отпуск КАК", "Документ." + ДокументДляЗагрузки + " КАК");
	Если ЗапросДокументаИсправления.Текст <> лкТекстЗапросаОтпуск Тогда
		ЗапросДокументаИсправления.Текст = лкТекстЗапросаОтпуск;
	КонецЕсли;
	
	Пока КоличествоПовторов <= 20 Цикл
		ЗапросДокументаИсправления.УстановитьПараметр("ИсправленныйДокумент", ДокументСсылка);
		ЗапросДокументаИсправленияВыборка = ЗапросДокументаИсправления.Выполнить().Выбрать();
		Если ЗапросДокументаИсправленияВыборка.Следующий() Тогда
			ДокументСсылка = ЗапросДокументаИсправленияВыборка.ДокументСсылка;
			КоличествоПовторов = КоличествоПовторов + 1;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ДокументСсылка.Пустая() Тогда
		Возврат  ДокументСсылка;
	КонецЕсли;
	
	ОтпускОбъект = Документы[ДокументДляЗагрузки].СоздатьДокумент();
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("Действие", "Исправить");
	ДанныеЗаполнения.Вставить("Ссылка", ДокументСсылка);
	
	Если ДокументДляЗагрузки = "ОтпускБезСохраненияОплаты" Тогда
		ИсправлениеДокументовЗарплатаКадры.СкопироватьДокумент(ОтпускОбъект, 
		ДанныеЗаполнения.Ссылка, 
		"ПерерасчетВыполнен,ДокументЗаполнения, Начислено", 
		"Начисления,НачисленияПерерасчет,НачисленияПерерасчетНулевыеСторно,
		|Показатели,РаспределениеРезультатовНачислений");
	Иначе
		//+КАБ Кириллова 210722
		ДокументыРазовыхНачислений.СкопироватьИсправляемыйДокумент(ОтпускОбъект, ДанныеЗаполнения.Ссылка,
		, 
		"НачисленияПерерасчет,
		|НДФЛ,
		|ПримененныеВычетыНаДетейИИмущественные,
		|РаспределениеРезультатовНачислений,
		|РаспределениеРезультатовУдержаний,
		|Удержания");
		
		//ДокументыРазовыхНачислений.СкопироватьИсправляемыйДокумент(ОтпускОбъект, 
		//ДанныеЗаполнения.Ссылка, 
		//"ДокументРассчитан,ДокументЗаполнения,Рассчитал, Начислено, Удержано, СреднийЗаработок, СохраняемоеДенежноеСодержание, СохраняемоеДенежноеСодержаниеНеИндексируемое", 
		//"ДанныеОбИндексации,Начисления,НачисленияПерерасчет,НачисленияПерерасчетНулевыеСторно,
		//|ОтпускаАвансомПерерасчет,НДФЛ,ОтработанноеВремяДляСреднегоОбщий,ПогашениеЗаймов,
		//|Показатели,ПримененныеВычетыНаДетейИИмущественные,
		//|РаспределениеРезультатовНачислений,РаспределениеРезультатовУдержаний,
		//|СреднийЗаработокОбщий,Удержания");
	КонецЕсли;
	ОтпускОбъект.ИсправленныйДокумент = ДанныеЗаполнения.Ссылка;
	////////////ЗарплатаКадрыРасширенный.ПриКопированииМногофункциональногоДокумента(ОтпускОбъект);
	
	
	ОтпускОбъект.Организация = ОрганизацияСсылка;
	ОтпускОбъект.Дата = НачалоДня(ТекущаяДата());  //+КАБ КИриллова 30.06.2022
	ОтпускОбъект.УстановитьНовыйНомер();
	ПользовательОтветственный = Справочники.Пользователи.НайтиПоНаименованию("Пользователь ЕФКС");
	Если ЗначениеЗаполнено(ПользовательОтветственный) Тогда
		ОтпускОбъект.Ответственный = ПользовательОтветственный;
	КонецЕсли;
	
	ОтпускОбъект.омУИД = ПолучитьСледующийУИД_ВСерии(ДокументДляЗагрузки,  ДокументИД);
	ОтпускОбъект.ПериодРегистрации = ПериодРегистрации;
	ОтпускОбъект.Комментарий = "Загружено из Парус " + СТРОКА(ТекущаяДата()) + "/номер приказа " + НомерПриказа +" от "+ ФОРМАТ(ДатаПриказа, "ДФ=""дд.ММ.гггг""");
	Если ДокументДляЗагрузки = "Отпуск" тогда
		Если  СтруктураЗаполнения.ПредоставитьОсновнойОтпуск Тогда
			//ОтпускОбъект.ДатаНачалаОсновногоОтпуска = СтруктураЗаполнения.ДатаНачалаОсновногоОтпуска;
			ОтпускОбъект.ДатаОкончанияОсновногоОтпуска = СтруктураЗаполнения.ДатаОкончанияОсновногоОтпуска;
			ОтпускОбъект.КоличествоДнейОсновногоОтпуска = ДатаКакЧисло(ОтпускОбъект.ДатаОкончанияОсновногоОтпуска) - ДатаКакЧисло(ОтпускОбъект.ДатаНачалаОсновногоОтпуска);
		КонецЕсли;
		Если  СтруктураЗаполнения.ПредоставитьДополнительныйОтпуск Тогда
			ТЧДопОтпуск = ОтпускОбъект.ДополнительныеОтпуска;
			МассивДополнительныеОтпуска = СтруктураЗаполнения.МассивДополнительныеОтпуска;
			Для Каждого СтруктураДополнительныйОтпуск Из МассивДополнительныеОтпуска Цикл
				лкВидОтпуска = СтруктураДополнительныйОтпуск.ВидОтпуска;
				СтруктураПоиска = Новый Структура;
				СтруктураПоиска.Вставить("ВидОтпуска", лкВидОтпуска);
				МассивСтрокТЧДопОтпуск = ТЧДопОтпуск.НайтиСтроки(СтруктураПоиска);
				Для Каждого СтрДопОтпуск Из МассивСтрокТЧДопОтпуск Цикл
					//СтрДопОтпуск.ДатаНачала = СтруктураДополнительныйОтпуск.ДатаНачала;
					СтрДопОтпуск.ДатаОкончания = СтруктураДополнительныйОтпуск.ДатаОкончания;
					СтрДопОтпуск.КоличествоДней = ДатаКакЧисло(СтрДопОтпуск.ДатаОкончания)-ДатаКакЧисло(СтрДопОтпуск.ДатаНачала);
				КонецЦикла;
			КонецЦикла;
		КонецЕсли; // если дополнительный отпуск
	Иначе // если отпуск без сохранения оплаты
		//ОтпускОбъект.ДатаНачала = СтруктураЗаполнения.ДатаНачала;
		ОтпускОбъект.ДатаОкончания = СтруктураЗаполнения.ДатаОкончания;
	КонецЕсли;
	
	
	Возврат ОтпускОбъект;
	
КонецФункции 


