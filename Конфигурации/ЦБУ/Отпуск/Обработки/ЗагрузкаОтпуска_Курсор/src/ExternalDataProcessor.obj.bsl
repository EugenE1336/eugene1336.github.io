Процедура ОбработкаКомпенсаций(СоответствиеДанныхДокументов)
	Если СоответствиеДанныхДокументов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Строка Из СоответствиеДанныхДокументов Цикл
		ТаблицаОтпусков = Новый ТаблицаЗначений;
		Для Каждого СвоистоXDTO из Строка.Значение[0].Свойства() Цикл	
			ТаблицаОтпусков.Колонки.Добавить(СвоистоXDTO.Имя);
		КонецЦикла;
		ТаблицаОтпусков.Колонки.Добавить("НомерСтроки");
		ДокументИД = Строка.Ключ;
		
		МассивСтрокXDTO = Строка.Значение;
		
		Если МассивСтрокXDTO.Количество() < 2 Тогда
			Продолжить;                                             
		КонецЕсли;
		
		i=0;
		Для Каждого ТекСтрокаЗначение Из МассивСтрокXDTO Цикл
			Если (ТекСтрокаЗначение.ПредоставитьКомпенсациюОсновногоОтпуска = "0" И ТекСтрокаЗначение.ПредоставитьКомпенсациюДополнительногоОтпуска = "0") или ТекСтрокаЗначение.ВидОтпуска = "106733692" ИЛИ ТекСтрокаЗначение.ВидОтпуска = "106790553" ИЛИ ТекСтрокаЗначение.Действие = "Отозвать" ИЛИ ТекСтрокаЗначение.ВидОтпуска = "236498269" Тогда
				i = i + 1; 
				Продолжить;
			Иначе	
				Если (ТекСтрокаЗначение.КоличествоДнейКомпенсацииОсновногоОтпуска = "" или ТекСтрокаЗначение.КоличествоДнейКомпенсацииОсновногоОтпуска = "0") и (ТекСтрокаЗначение.КоличествоДнейКомпенсацииДополнительногоОтпуска = "" Или ТекСтрокаЗначение.КоличествоДнейКомпенсацииДополнительногоОтпуска = "0") Тогда
					i=i+1;
					Продолжить;
				Иначе
					
					ТекСтрокаЗначениеСвойства = ТекСтрокаЗначение.Свойства();
					НоваяСтрока = ТаблицаОтпусков.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока,ТекСтрокаЗначение);
					НоваяСтрока.ВидОтпуска="54279638";  
					
					Если СОКРЛП(ТекСтрокаЗначение.ДатаНачалаОсновногоОтпуска) = "" Тогда
						ДатаНачалаОсновногоОтпуска = ДАТА(1,1,1);
					Иначе
						ДатаНачалаОсновногоОтпуска = XMLЗначение(Тип("дата"),ТекСтрокаЗначение.ДатаНачалаОсновногоОтпуска);
					КонецЕсли;
					
					Если СОКРЛП(ТекСтрокаЗначение.ДатаОкончанияОсновногоОтпуска) = "" Тогда
						ДатаОкончанияОсновногоОтпуска = ДАТА(1,1,1);
					Иначе
						ДатаОкончанияОсновногоОтпуска = XMLЗначение(Тип("дата"),ТекСтрокаЗначение.ДатаОкончанияОсновногоОтпуска);
					КонецЕсли;
					
					Если СОКРЛП(ТекСтрокаЗначение.НачалоПериодаЗаКоторыйПредоставляетсяОтпуск) = "" Тогда
						НачалоПериодаЗаКоторыйПредоставляетсяОтпуск = ДАТА(1,1,1);
					Иначе
						НачалоПериодаЗаКоторыйПредоставляетсяОтпуск = XMLЗначение(Тип("дата"),ТекСтрокаЗначение.НачалоПериодаЗаКоторыйПредоставляетсяОтпуск);
					КонецЕсли;
					
					Если СОКРЛП(ТекСтрокаЗначение.КонецПериодаЗаКоторыйПредоставляетсяОтпуск) = "" Тогда
						КонецПериодаЗаКоторыйПредоставляетсяОтпуск = ДАТА(1,1,1);
					Иначе
						КонецПериодаЗаКоторыйПредоставляетсяОтпуск = XMLЗначение(Тип("дата"),ТекСтрокаЗначение.КонецПериодаЗаКоторыйПредоставляетсяОтпуск);
					КонецЕсли;
					
					
					
					НоваяСтрока.ДатаНачалаОсновногоОтпуска 		=  ДатаНачалаОсновногоОтпуска;
					НоваяСтрока.ДатаОкончанияОсновногоОтпуска 	=  ДатаОкончанияОсновногоОтпуска;
					НоваяСтрока.НачалоПериодаЗаКоторыйПредоставляетсяОтпуск =  НачалоПериодаЗаКоторыйПредоставляетсяОтпуск;
					НоваяСтрока.КонецПериодаЗаКоторыйПредоставляетсяОтпуск =  КонецПериодаЗаКоторыйПредоставляетсяОтпуск;
					НоваяСтрока.НомерСтроки  = i;
				КонецЕсли;
			КонецЕсли;	
			i=i+1;
		КонецЦикла;
		
		ТаблицаОтпусков.Сортировать("ВидОтпуска,ДатаНачалаОсновногоОтпуска");
		
		
		ПредСтрока = Неопределено;
		МассивУдаления = Новый Массив();
		
		Для Каждого ТекСтрока из ТаблицаОтпусков Цикл
			Если ТаблицаОтпусков.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			Если  ПредСтрока = Неопределено или Не ПредСтрока.ВидОтпуска = ТекСтрока.ВидОтпуска Тогда	
				ПредСтрока =ТекСтрока;
				Продолжить;	
			КонецЕсли;
			
			СтрокаXDTO = МассивСтрокXDTO[ПредСтрока.НомерСтроки];
			СтрокаXDTOТек = МассивСтрокXDTO[ТекСтрока.НомерСтроки];
			
			//Если (ТекСтрока.ДатаНачалаОсновногоОтпуска - ПредСтрока.ДатаОкончанияОсновногоОтпуска)/60/60/24 = 1 Тогда
			МассивУдаления.Добавить(ТекСтрока.НомерСтроки);
			//СтрокаXDTO.Установить("ДатаОкончанияОсновногоОтпуска",СтрокаXDTOТек.ДатаОкончанияОсновногоОтпуска);
			//ПредСтрока.ДатаОкончанияОсновногоОтпуска = ТекСтрока.ДатаОкончанияОсновногоОтпуска ;
			
			СтрокаXDTO.Установить("КоличествоДнейКомпенсацииОсновногоОтпуска",Строка(Число(СтрокаXDTOТек.КоличествоДнейКомпенсацииОсновногоОтпуска)+Число(СтрокаXDTO.КоличествоДнейКомпенсацииОсновногоОтпуска)));
			//КонецЕсли;	
			
			СтрокаXDTO.Установить("КонецПериодаЗаКоторыйПредоставляетсяОтпуск",?(ТекСтрока.КонецПериодаЗаКоторыйПредоставляетсяОтпуск > ПредСтрока.КонецПериодаЗаКоторыйПредоставляетсяОтпуск,СтрокаXDTOТек.КонецПериодаЗаКоторыйПредоставляетсяОтпуск,СтрокаXDTO.КонецПериодаЗаКоторыйПредоставляетсяОтпуск));
			СтрокаXDTO.Установить("НачалоПериодаЗаКоторыйПредоставляетсяОтпуск",?(ТекСтрока.НачалоПериодаЗаКоторыйПредоставляетсяОтпуск > ПредСтрока.НачалоПериодаЗаКоторыйПредоставляетсяОтпуск,СтрокаXDTO.НачалоПериодаЗаКоторыйПредоставляетсяОтпуск,СтрокаXDTOТек.НачалоПериодаЗаКоторыйПредоставляетсяОтпуск));	
			
		КонецЦикла;
		
		Список = Новый СписокЗначений; 
		Список.ЗагрузитьЗначения(МассивУдаления); 
		Список.СортироватьПоЗначению(НаправлениеСортировки.возр);
		МассивУдаления = Список.ВыгрузитьЗначения(); 
		Если МассивУдаления.Количество() > 0 Тогда
			Для ОИ = - МассивУдаления.ВГраница() По 0 Цикл
				Индекс = - ОИ;
				Строка.Значение.Удалить(МассивУдаления[Индекс]);        
			КонецЦикла;
		КонецЕсли;
		Если Строка.Значение.Количество() = 1 И ЗначениеЗаполнено(Строка.Значение[0].КоличествоДнейКомпенсацииОсновногоОтпуска) и НЕ Строка.Значение[0].ВидОтпуска = "103566120"  Тогда
			Строка.Значение[0].ВидОтпуска = "54279638"; 
			Строка.Значение[0].КоличествоДнейОсновногоОтпуска = "0";
			Строка.Значение[0].ПредоставитьОсновнойОтпуск = "0";
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры

