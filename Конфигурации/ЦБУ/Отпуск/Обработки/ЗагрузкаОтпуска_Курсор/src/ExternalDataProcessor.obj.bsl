	Запросы.Вставить("ТекстЗапросаОтпуск", ТекстЗапросаОтпуск);
	Запросы.Вставить("ЗапросДокументОснованиеВозвратИзОУР", ЗапросДокументОснованиеВозвратИзОУР);
	Возврат Запросы;
КонецФункции

// --- Разбор полей строки XDTO ---
Функция РазобратьПоляСтрокиОтпускаПакета(СтрокаXDTO)

	СвойстваСтроки = СтрокаXDTO.Свойства();
	Если СОКРЛП(СтрокаXDTO.Действие) = "" Тогда
		ДействиеДокумента = "";
	Иначе
		ДействиеДокумента = СокрЛП(СтрокаXDTO.Действие);
	КонецЕсли;
	Если ДействиеДокумента = "Отозвать" Тогда
		ЭтоОтзыв = Истина;
	Иначе
		ЭтоОтзыв = Ложь;
	КонецЕсли;
	
	ДатаНачалаОсновногоОтпуска = ДатаИзСтрокиПакета(СтрокаXDTO.ДатаНачалаОсновногоОтпуска);
	ДатаОкончанияОсновногоОтпуска = ДатаИзСтрокиПакета(СтрокаXDTO.ДатаОкончанияОсновногоОтпуска);
	
	Если СтрокаXDTO.Свойства().Получить("ИсправлениеОт") = Неопределено Тогда
		ИсправлениеОт = Дата(1, 1, 1);
	Иначе
		ИсправлениеОт = ДатаИзСтрокиПакета(СтрокаXDTO.ИсправлениеОт);
	КонецЕсли;
	
	НачалоПериодаЗаКоторыйПредоставляетсяОтпуск = ДатаИзСтрокиПакета(СтрокаXDTO.НачалоПериодаЗаКоторыйПредоставляетсяОтпуск);
	КонецПериодаЗаКоторыйПредоставляетсяОтпуск = ДатаИзСтрокиПакета(СтрокаXDTO.КонецПериодаЗаКоторыйПредоставляетсяОтпуск);
	
	Если СОКРЛП(СтрокаXDTO.КоличествоДнейОсновногоОтпуска) = "" Тогда
		КоличествоДнейОсновногоОтпуска = 0;
	Иначе
		КоличествоДнейОсновногоОтпуска = XMLЗначение(Тип("Число"),СтрокаXDTO.КоличествоДнейОсновногоОтпуска);
	КонецЕсли;  
	
	Если СОКРЛП(СтрокаXDTO.КоличествоДнейКомпенсацииДополнительногоОтпуска) = "" Тогда
		КоличествоДнейКомпенсацииДополнительногоОтпуска = 0;
	Иначе
		КоличествоДнейКомпенсацииДополнительногоОтпуска = XMLЗначение(Тип("Число"),СтрокаXDTO.КоличествоДнейКомпенсацииДополнительногоОтпуска);
	КонецЕсли;
	
	Если СОКРЛП(СтрокаXDTO.ПредоставитьКомпенсациюОсновногоОтпуска) = "" Тогда
		ПредоставитьКомпенсациюОсновногоОтпуска = Ложь;
	ИначеЕсли СОКРЛП(СтрокаXDTO.ПредоставитьКомпенсациюОсновногоОтпуска) = "1" Тогда
		ПредоставитьКомпенсациюОсновногоОтпуска = Истина;
	Иначе
		ПредоставитьКомпенсациюОсновногоОтпуска = Ложь;
	КонецЕсли;
	Если СОКРЛП(СтрокаXDTO.КоличествоДнейКомпенсацииОсновногоОтпуска) = "" Тогда
		КоличествоДнейКомпенсацииОсновногоОтпуска = 0;
	Иначе
		КоличествоДнейКомпенсацииОсновногоОтпуска = XMLЗначение(Тип("Число"),СтрокаXDTO.КоличествоДнейКомпенсацииОсновногоОтпуска);
	КонецЕсли;
	
	Если СОКРЛП(СтрокаXDTO.ПредоставитьМатериальнуюПомощьПриОтпуске) = "" Тогда
		ПредоставитьМатериальнуюПомощьПриОтпуске = Ложь;
	ИначеЕсли СОКРЛП(СтрокаXDTO.ПредоставитьМатериальнуюПомощьПриОтпуске) = "1" Тогда
		ПредоставитьМатериальнуюПомощьПриОтпуске = Истина;
	Иначе
		ПредоставитьМатериальнуюПомощьПриОтпуске = Ложь;
	КонецЕсли;
	
	Если СвойстваСтроки.Получить("ПредоставитьЕдиновременнуюВыплатуКОтпуску") = Неопределено Тогда
		ПредоставитьЕдиновременнуюВыплатуКОтпуску = Ложь;
	ИначеЕсли СОКРЛП(СтрокаXDTO.ПредоставитьЕдиновременнуюВыплатуКОтпуску) = "" Тогда
		ПредоставитьЕдиновременнуюВыплатуКОтпуску = Ложь;
	ИначеЕсли СОКРЛП(СтрокаXDTO.ПредоставитьЕдиновременнуюВыплатуКОтпуску) = "1" Тогда
		ПредоставитьЕдиновременнуюВыплатуКОтпуску = Истина;
	Иначе
		ПредоставитьЕдиновременнуюВыплатуКОтпуску = Ложь;
	КонецЕсли;
	
	ДатаОтпуска = ДатаНачалаОсновногоОтпуска;
	Если НЕ ЗначениеЗаполнено(ДатаОтпуска) Тогда
		ДатаОтпуска = НачалоДня(ТекущаяДата());   //+КАБ КИриллова 30.06.2022
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("ДействиеДокумента", ДействиеДокумента);
	Результат.Вставить("ЭтоОтзыв", ЭтоОтзыв);
	Результат.Вставить("ДатаНачалаОсновногоОтпуска", ДатаНачалаОсновногоОтпуска);
	Результат.Вставить("ДатаОкончанияОсновногоОтпуска", ДатаОкончанияОсновногоОтпуска);
	Результат.Вставить("ИсправлениеОт", ИсправлениеОт);
	Результат.Вставить("НачалоПериодаЗаКоторыйПредоставляетсяОтпуск", НачалоПериодаЗаКоторыйПредоставляетсяОтпуск);
	Результат.Вставить("КонецПериодаЗаКоторыйПредоставляетсяОтпуск", КонецПериодаЗаКоторыйПредоставляетсяОтпуск);
	Результат.Вставить("КоличествоДнейОсновногоОтпуска", КоличествоДнейОсновногоОтпуска);
	Результат.Вставить("КоличествоДнейКомпенсацииДополнительногоОтпуска", КоличествоДнейКомпенсацииДополнительногоОтпуска);
	Результат.Вставить("ПредоставитьКомпенсациюОсновногоОтпуска", ПредоставитьКомпенсациюОсновногоОтпуска);
	Результат.Вставить("КоличествоДнейКомпенсацииОсновногоОтпуска", КоличествоДнейКомпенсацииОсновногоОтпуска);
	Результат.Вставить("ПредоставитьМатериальнуюПомощьПриОтпуске", ПредоставитьМатериальнуюПомощьПриОтпуске);
	Результат.Вставить("ПредоставитьЕдиновременнуюВыплатуКОтпуску", ПредоставитьЕдиновременнуюВыплатуКОтпуску);
	Результат.Вставить("ДатаОтпуска", ДатаОтпуска);

	Возврат Результат;

КонецФункции

// --- Ответственный за документы ---
Функция ПолучитьОтветственногоЗагрузкиДокументов(ТекстДляРегистрацииОшибки, ЕстьОшибкиУровняНеОжидание, ЕстьОшибкиПоДокументу)

	ПользовательОтветственный = Константы.омПользовательДляЗаполненияДокументов.Получить();
	Успех = ЗначениеЗаполнено(ПользовательОтветственный);
	Результат = Новый Структура;
	Результат.Вставить("ПользовательОтветственный", ПользовательОтветственный);
	Результат.Вставить("Успех", Успех);

	Если НЕ Успех Тогда
		ТекстДляРегистрацииОшибки = ТекстДляРегистрацииОшибки + ?(ТекстДляРегистрацииОшибки = "", "", Символы.ПС) + "Не выбран пользователь для заполнения документов!";
		ЕстьОшибкиУровняНеОжидание = Истина;
		ЕстьОшибкиПоДокументу = Истина;
	КонецЕсли;

	Результат.Вставить("ТекстДляРегистрацииОшибки", ТекстДляРегистрацииОшибки);
	Результат.Вставить("ЕстьОшибкиУровняНеОжидание", ЕстьОшибкиУровняНеОжидание);
	Результат.Вставить("ЕстьОшибкиПоДокументу", ЕстьОшибкиПоДокументу);
	Возврат Результат;

КонецФункции

// --- Обработка строк группы документов ---
Процедура ОбработатьСтрокиГруппыДокументовПакета(КонтекстДокумента, КонтекстЗагрузки)

	МассивРаботаВВыходныеДни = КонтекстДокумента.МассивРаботаВВыходныеДни;
	ЕстьОшибкиПоДокументу = КонтекстДокумента.ЕстьОшибкиПоДокументу;
	ДокументИД = КонтекстДокумента.ДокументИД;
	МассивСтрокXDTO = КонтекстДокумента.МассивСтрокXDTO;
	НомерПриказа = КонтекстДокумента.НомерПриказа;
	ДатаПриказа = КонтекстДокумента.ДатаПриказа;
	ПериодРегистрации = КонтекстДокумента.ПериодРегистрации;
	ДокументДляЗагрузки = КонтекстДокумента.ДокументДляЗагрузки;
	СтруктураЗаполнения = КонтекстДокумента.СтруктураЗаполнения;
	МассивДополнительныеОтпуска = КонтекстДокумента.МассивДополнительныеОтпуска;
	МассивДнейУхода = КонтекстДокумента.МассивДнейУхода;
	БылПервыйДопОтп = КонтекстДокумента.БылПервыйДопОтп;
	МассивДатОтзыва = КонтекстДокумента.МассивДатОтзыва;

	КонтекстДокумента.Вставить("ПрерватьСтроки", Ложь);

	Для Каждого ТекСтрокаЗначение Из МассивСтрокXDTO Цикл
			УдалитьДни = Ложь;

			ПоляСтроки = РазобратьПоляСтрокиОтпускаПакета(ТекСтрокаЗначение);
			ДействиеДокумента = ПоляСтроки.ДействиеДокумента;
			ЭтоОтзыв = ПоляСтроки.ЭтоОтзыв;
			ДатаНачалаОсновногоОтпуска = ПоляСтроки.ДатаНачалаОсновногоОтпуска;
			ДатаОкончанияОсновногоОтпуска = ПоляСтроки.ДатаОкончанияОсновногоОтпуска;
			ИсправлениеОт = ПоляСтроки.ИсправлениеОт;
			НачалоПериодаЗаКоторыйПредоставляетсяОтпуск = ПоляСтроки.НачалоПериодаЗаКоторыйПредоставляетсяОтпуск;
			КонецПериодаЗаКоторыйПредоставляетсяОтпуск = ПоляСтроки.КонецПериодаЗаКоторыйПредоставляетсяОтпуск;
			КоличествоДнейОсновногоОтпуска = ПоляСтроки.КоличествоДнейОсновногоОтпуска;
			КоличествоДнейКомпенсацииДополнительногоОтпуска = ПоляСтроки.КоличествоДнейКомпенсацииДополнительногоОтпуска;
			ПредоставитьКомпенсациюОсновногоОтпуска = ПоляСтроки.ПредоставитьКомпенсациюОсновногоОтпуска;
			КоличествоДнейКомпенсацииОсновногоОтпуска = ПоляСтроки.КоличествоДнейКомпенсацииОсновногоОтпуска;
			ПредоставитьМатериальнуюПомощьПриОтпуске = ПоляСтроки.ПредоставитьМатериальнуюПомощьПриОтпуске;
			ПредоставитьЕдиновременнуюВыплатуКОтпуску = ПоляСтроки.ПредоставитьЕдиновременнуюВыплатуКОтпуску;
			ДатаОтпуска = ПоляСтроки.ДатаОтпуска;
			//+ КАБ Куцеборский 27.09.22
			ВидЗанятости = "";
			Если ТекСтрокаЗначение.Свойства().Получить("ВидЗанятости") <> Неопределено Тогда
				Если СокрЛП(ТекСтрокаЗначение.ВидЗанятости) = "основной работник" Тогда
					ВидЗанятости = Перечисления.ВидыЗанятости.ОсновноеМестоРаботы;
				ИначеЕсли СокрЛП(ТекСтрокаЗначение.ВидЗанятости) = "Внешний совместитель" Тогда
					ВидЗанятости = Перечисления.ВидыЗанятости.Совместительство;
				Иначе
					ВидЗанятости = Перечисления.ВидыЗанятости.ОсновноеМестоРаботы;
				КонецЕсли;
			КонецЕсли;
			//- КАБ Куцеборский
			
			СотрудникИД = "";
			Если ТекСтрокаЗначение.Свойства().Получить("Сотрудник") <> Неопределено Тогда
				СотрудникИД = СокрЛП(ТекСтрокаЗначение.Сотрудник);				
			КонецЕсли;
			Если  ПустаяСтрока(СотрудникИД) ТОгда
				КонтекстЗагрузки.ТекстДляРегистрацииОшибки = КонтекстЗагрузки.ТекстДляРегистрацииОшибки + ?(КонтекстЗагрузки.ТекстДляРегистрацииОшибки = "", "", Символы.ПС) + СтандартнаяСтрокаОшибки("Справочник.Сотрудники", "", "не задан УИД");
				ЕстьОшибкиПоДокументу = Истина;
				КонтекстЗагрузки.ЕстьОшибкиУровняНеОжидание = Истина;
			КонецЕсли;
			ФизЛицоИД = "";
			Если ТекСтрокаЗначение.Свойства().Получить("ФизЛицо") <> Неопределено Тогда
				ФизЛицоИД = СокрЛП(ТекСтрокаЗначение.ФизЛицо);
			ИначеЕсли ТекСтрокаЗначение.Свойства().Получить("ФизическоеЛицо") <> Неопределено Тогда
				ФизЛицоИД = СокрЛП(ТекСтрокаЗначение.ФизическоеЛицо);
			КонецЕсли;
			Если  ПустаяСтрока(ФизЛицоИД) ТОгда
				КонтекстЗагрузки.ТекстДляРегистрацииОшибки = КонтекстЗагрузки.ТекстДляРегистрацииОшибки + ?(КонтекстЗагрузки.ТекстДляРегистрацииОшибки = "", "", Символы.ПС) + СтандартнаяСтрокаОшибки("Справочник.ФизическиеЛица", "", "не задан УИД");
				ЕстьОшибкиПоДокументу = Истина;
				КонтекстЗагрузки.ЕстьОшибкиУровняНеОжидание = Истина;
			Иначе
				ФизЛицоСсылка = Справочники.ФизическиеЛица.НайтиПоРеквизиту("омУИД", ФизЛицоИД);
				Если НЕ ЗначениеЗаполнено(ФизЛицоСсылка) Тогда
					КонтекстЗагрузки.ТекстДляРегистрацииОшибки = КонтекстЗагрузки.ТекстДляРегистрацииОшибки + ?(КонтекстЗагрузки.ТекстДляРегистрацииОшибки = "", "", Символы.ПС) + СтандартнаяСтрокаОшибки("Справочник.ФизическиеЛица", ФизЛицоИД, "Не найдено по УИД");
					ЕстьОшибкиПоДокументу = Истина;
					КонтекстЗагрузки.ЕстьОшибкиУровняНеОжидание = Истина;
				КонецЕсли;
			КонецЕсли;
			
			//+ КАБ Куцеборский 07.09.22
			ИсправлениеИД = "";
			Если ТекСтрокаЗначение.Свойства().Получить("Исправительный") <> Неопределено Тогда
				Если СокрЛП(ТекСтрокаЗначение.Исправительный) = "" Тогда
					ИсправлениеИД = "";
				Иначе
					ИсправлениеИД = СокрЛП(ТекСтрокаЗначение.Исправительный);
				КонецЕсли;	
				//ИсправлениеИД = ИсправлениеИД + "_" + СотрудникИД;
			КонецЕсли;
			//-
			
			
			ВидЗанятостиСтрока = СокрЛП(ТекСтрокаЗначение.ВидЗанятости);
			ШтаткаИД = СокрЛП(ТекСтрокаЗначение.ПозицияШтатногоРасписания);
			ИсполнениеИД = СОКРЛП(ТекСтрокаЗначение.Сотрудник);
			Если ИсполнениеИД = "" Тогда
				КонтекстЗагрузки.ТекстДляРегистрацииОшибки = КонтекстЗагрузки.ТекстДляРегистрацииОшибки + ?(КонтекстЗагрузки.ТекстДляРегистрацииОшибки = "", "", Символы.ПС) + СтандартнаяСтрокаОшибки("Справочник.ШтатноеРасписание", "", "не задан ИД");
				КонтекстЗагрузки.ЕстьОшибкиУровняНеОжидание = Истина;
				Продолжить;
			КонецЕсли;
			СтруктураСотрудник = омПроцедурыФункцииИШДСерверПереопределяемый.НайтиСоздатьСотрудникаСопоставлениемПоИдентификаторуИсполнения(ИсполнениеИД,Ложь,Неопределено);
			
			Если СтруктураСотрудник.СотрудникНайден <> Истина Тогда
				лкСтрокаОшибки = СтруктураСотрудник.ОписаниеОшибки;
				СотрудникСсылка = Справочники.Сотрудники.ПустаяСсылка();
				Если ШтаткаИД <> ""  И ЗначениеЗаполнено(ФизЛицоСсылка) Тогда  //И ВидЗанятостиСтрока <> ""
					СтруктураСопоставленныйОбъект = РегистрыСведений.омСопоставлениеОбъектов.ПолучитьЗаписатьОбъект("Справочник.ШтатноеРасписание", ШтаткаИД,,Ложь);
					Если СтруктураСопоставленныйОбъект.ОбъектСсылкаНайден = Истина Тогда
						ШтаткаСсылка = СтруктураСопоставленныйОбъект.ОбъектСсылка;
						//ВидЗанятости = Перечисления.ВидыЗанятости.ОсновноеМестоРаботы;
						СтруктураСотрудник = омПроцедурыФункцииИШДСерверПереопределяемый.НайтиСотрудникаПоФизЛицуПозицииШтатногоРасписанияВидуЗанятости(ДатаОтпуска,КонтекстЗагрузки.ОрганизацияСсылка,ФизЛицоСсылка,ШтаткаСсылка,ВидЗанятости,Ложь);
						Если СтруктураСотрудник.СотрудникНайден = Истина Тогда
							СотрудникСсылка = СтруктураСотрудник.СотрудникСсылка;
							// запишем сопоставление этого сотрудника с ИД исполнения
							СтруктураСотрудник = омПроцедурыФункцииИШДСерверПереопределяемый.НайтиСоздатьСотрудникаСопоставлениемПоИдентификаторуИсполнения(ИсполнениеИД,Ложь,СотрудникСсылка);
