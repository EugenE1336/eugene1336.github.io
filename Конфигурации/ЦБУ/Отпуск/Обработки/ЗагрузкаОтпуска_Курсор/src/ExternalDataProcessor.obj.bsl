				|	ДанныеДляРасчетаЗарплаты.ВидДокумента КАК ВидДокумента,
				|	ДанныеДляРасчетаЗарплатыЗначенияПоказателей.Значение КАК Значение
				|ИЗ
				|	Документ.ДанныеДляРасчетаЗарплаты КАК ДанныеДляРасчетаЗарплаты
				|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ДанныеДляРасчетаЗарплаты.ЗначенияПоказателей КАК ДанныеДляРасчетаЗарплатыЗначенияПоказателей
				|		ПО (ДанныеДляРасчетаЗарплатыЗначенияПоказателей.Ссылка = ДанныеДляРасчетаЗарплаты.Ссылка)
				|ГДЕ
				|	ДанныеДляРасчетаЗарплатыЗначенияПоказателей.Показатель = &Показатель
				|
				|УПОРЯДОЧИТЬ ПО
				|	Период УБЫВ";
				
				Запрос.УстановитьПараметр("Показатель", Показатель);
				РезультатЗапроса = Запрос.Выполнить();
				ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
				
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					МаксимальнаяСтоимостьСанаторноКурортнойПутевки = ВыборкаДетальныеЗаписи.Значение;
				КонецЦикла;
				Если Не ЗначениеЗаполнено(МаксимальнаяСтоимостьСанаторноКурортнойПутевки) Тогда
					КонтекстЗагрузки.ТекстДляРегистрацииОшибки = КонтекстЗагрузки.ТекстДляРегистрацииОшибки + " Не найден показатель для сан.-кур. путевки";
					ЕстьОшибкиПоДокументу = Истина;
				КонецЕсли;	
				СтруктураЗаполнения.Вставить("МаксимальнаяСтоимостьСанаторноКурортнойПутевки", МаксимальнаяСтоимостьСанаторноКурортнойПутевки);
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	Начисления.Ссылка КАК Ссылка,
				|	Начисления.Наименование КАК Наименование,
				|	Начисления.ФормулаРасчета КАК ФормулаРасчета
				|ИЗ
				|	ПланВидовРасчета.Начисления КАК Начисления
				|ГДЕ
				|	Начисления.Ссылка = &Ссылка";
				
				Запрос.УстановитьПараметр("Ссылка", ВидРасчетаСсылка);
				РезультатЗапроса = Запрос.Выполнить();
				ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
				
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					ФормулаДляРасчета = ВыборкаДетальныеЗаписи.ФормулаРасчета;
				КонецЦикла;
				Если Не ЗначениеЗаполнено(ФормулаДляРасчета) Тогда
					КонтекстЗагрузки.ТекстДляРегистрацииОшибки = КонтекстЗагрузки.ТекстДляРегистрацииОшибки + "Не найдена формула для расчета компенсации сан.-кур. путевки";
					ЕстьОшибкиПоДокументу = Истина;
				КонецЕсли;
			КонецЕсли;
			
			//+ КАБ Куцеборский 13.09.22
			Если ЭтоОтзыв Тогда
				
				МассивДатОтзыва.Добавить(СтруктураДат);
			КонецЕсли;	
			//- КАБ Куцеборский
		КонецЦикла;  // по строкам пакета для документа

	Если ДокументДляЗагрузки = "Отпуск" И ЕстьСтрокаПредоставленияВГруппе(МассивСтрокXDTO) Тогда
		СтрокаXDTOПредоставление = НайтиСтрокуПредоставленияВГруппе(МассивСтрокXDTO);
