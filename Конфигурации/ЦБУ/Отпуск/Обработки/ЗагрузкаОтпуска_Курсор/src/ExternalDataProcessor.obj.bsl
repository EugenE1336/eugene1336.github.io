			ОтпускОбъект.ИсправленныйДокумент = Исправление;
		КонецЕсли;
	Иначе	
		
		// Если НЕ ДействиеДокумента = "Продлить" Тогда
		
		// Проверяем, изменились ли загружаемые реквизиты. Если изменились, меняем документ либо создаем документ исправления
		Если ОтпускСсылка.Проведен <> Истина Тогда
			Если ЭтоСанКур тогда
				ОтпускОбъект = ОтпускСсылка.ПолучитьОбъект();   //КАБ криллова 21.07.2022 не работает эта функция для сотрудников в табл. части. поэтому перезапишем документ - ничег страшного, все равно его еще не отработали!
				//и очистим табл часть.
				ОтпускОбъект.Начисления.Очистить();
				ОтпускОбъект.ФизическиеЛица.Очистить();
				ОтпускОбъект.Показатели.Очистить();
				ОтпускОбъект.Удержания.Очистить();  
				ОтпускОбъект.НачисленияПерерасчет.Очистить(); 
				ОтпускОбъект.НДФЛ.Очистить();
			ИначеЕсли ЭтоРаботаВВыходныеДни тогда  //КАб кириллова 22.07.22повторная загрузка выходных дней, а документ уже есть и не проведен . тогда грузим заново
				ОтпускОбъект = ОтпускСсылка.ПолучитьОбъект(); 
				ОтпускОбъект.сотрудники.Очистить();
				ОтпускОбъект.физическиеЛица.Очистить();
			Иначе
				ЕстьИзменения = омОбщегоНазначенияСервер.ЕстьИзмененияПередаваемыхРеквизитовДокумента(СтруктураЗаполнения, ОтпускСсылка);
				//ЕстьИзменения = Истина;
				Если НЕ ЕстьИзменения Тогда
					Результат.Обработано = Истина;
					Возврат Результат; // по всем загружаемым реквизитам документ совпадает с данными пакета, менять ничего не надо
				КонецЕсли;
				ОтпускОбъект = ОтпускСсылка.ПолучитьОбъект();
			КонецЕсли
		Иначе
			// Ищем последний документ в цепочке исправлений, идущих от найденного по УИД.  
			ДокументСсылка = ОтпускСсылка;
			Если не ЭтоРаботаВВыходныеДни Тогда
				
				КоличествоПовторов = 0;
				лкТекстЗапросаОтпуск = СтрЗаменить(КонтекстЗагрузки.Запросы.ТекстЗапросаОтпуск, "Документ.Отпуск КАК", "Документ." + ДокументДляЗагрузки + " КАК");
				Если КонтекстЗагрузки.Запросы.ЗапросДокументаИсправления.Текст <> лкТекстЗапросаОтпуск Тогда
					КонтекстЗагрузки.Запросы.ЗапросДокументаИсправления.Текст = лкТекстЗапросаОтпуск;
				КонецЕсли;
				
				Пока КоличествоПовторов <= 20 Цикл
					КонтекстЗагрузки.Запросы.ЗапросДокументаИсправления.УстановитьПараметр("ИсправленныйДокумент", ДокументСсылка);
					ЗапросДокументаИсправленияВыборка = КонтекстЗагрузки.Запросы.ЗапросДокументаИсправления.Выполнить().Выбрать();
					Если ЗапросДокументаИсправленияВыборка.Следующий() Тогда
						ДокументСсылка = ЗапросДокументаИсправленияВыборка.ДокументСсылка;
						КоличествоПовторов = КоличествоПовторов + 1;
					Иначе
						Прервать;
					КонецЕсли;
				КонецЦикла;
				// получен последний документ в цепочке исправлений
				//+КАБ Кириллова 210722
				Если ЭтоСанКур и ДокументСсылка.ДатаНачала = НачалоМесяца(ТекущаяДата())  тогда
					ЕстьИзменения   = ложь;
					СООБЩИТЬ("попытка исправить Санкуры в том же периоде. в котором уже есть расчитанный документ (тот же приказ)!");		
				ИначеЕсли   ЭтоСанКур тогда
					ЕстьИзменения   = Истина;
				Иначе
					ЕстьИзменения = омОбщегоНазначенияСервер.ЕстьИзмененияПередаваемыхРеквизитовДокумента(СтруктураЗаполнения, ДокументСсылка);
				КонецЕсли;
				//ЕстьИзменения = Истина;
				Если НЕ ЕстьИзменения Тогда
					Результат.Обработано = Истина;
					Возврат Результат; // по всем загружаемым реквизитам последний в цепочке документ совпадает с данными пакета, менять ничего не надо
				КонецЕсли;
			КонецЕсли;
			// если последний документ в цепочке проведен, то создаем документ исправления к нему, если нет, изменяем его.
			Если ДокументСсылка.Проведен Тогда
				
				ОтпускОбъект = Документы[ДокументДляЗагрузки].СоздатьДокумент();
				//ОтпускОбъект.Дата = ТекущаяДата();
				//ОтпускОбъект.Организация = КонтекстЗагрузки.ОрганизацияСсылка;
				
				ДанныеЗаполнения = Новый Структура;
				ДанныеЗаполнения.Вставить("Действие", "Исправить");
				ДанныеЗаполнения.Вставить("Ссылка", ДокументСсылка);
				
				Если ЭтоВозвратИзОУР ИЛИ ЭтоОтпускПоУходуЗаРебенком_15 ИЛИ ЭтоОтпускПоУходуЗаРебенком_3 Тогда
					ИсправлениеДокументовЗарплатаКадры.СкопироватьДокумент(ОтпускОбъект, ДанныеЗаполнения.Ссылка,,);
				ИначеЕсли ЭтоОтпускБезСохраненияОплаты Тогда
					ИсправлениеДокументовЗарплатаКадры.СкопироватьДокумент(ОтпускОбъект, 
					ДанныеЗаполнения.Ссылка, 
					"ПерерасчетВыполнен,ДокументЗаполнения", 
					"Начисления,НачисленияПерерасчет,НачисленияПерерасчетНулевыеСторно,
					|Показатели,РаспределениеРезультатовНачислений");
				ИначеЕсли ЭтоОтпускПоУходуЗаДетьмиИнвалидами Тогда
					ИсправлениеДокументовЗарплатаКадры.СкопироватьДокумент(ОтпускОбъект, 
					ДанныеЗаполнения.Ссылка, 
					"ДокументРассчитан", 
					"Начисления,
					|НачисленияПерерасчет,
					|НачисленияПерерасчетНулевыеСторно,
					|НДФЛ,
					|ПримененныеВычетыНаДетейИИмущественные,
					|РаспределениеРезультатовНачислений,
					|РаспределениеРезультатовУдержаний,
					|Удержания");
				ИначеЕсли ЭтоОплатаПоСреднемуЗаработку Тогда
					ИсправлениеДокументовЗарплатаКадры.СкопироватьДокумент(ОтпускОбъект, 
					ДанныеЗаполнения.Ссылка, 
					"ДокументРассчитан", 
					"ДанныеОбИндексации,Начисления,НачисленияПерерасчет,НачисленияПерерасчетНулевыеСторно,
					|НДФЛ,ОтработанноеВремяДляСреднегоОбщий,
					|Показатели,ПримененныеВычетыНаДетейИИмущественные,
					|РаспределениеРезультатовНачислений,РаспределениеРезультатовУдержаний,
					|СреднийЗаработокОбщий,Удержания");
				Иначе
					//+КАБ Кириллова 210722
					//ОтпускОбъект.МесяцНачисления =  ТекущаяДата();
					//ОтпускОбъект.Дата = ТекущаяДата();
					//ОтпускОбъект.ДатаНачала= ТекущаяДата();
					//ОтпускОбъект.ДатаОкончания= ТекущаяДата();  						
					
					ИсправлениеДокументовЗарплатаКадры.СкопироватьДокумент(ОтпускОбъект, ДокументСсылка,
					, 
					"НачисленияПерерасчет,
					|НДФЛ,
					|ПримененныеВычетыНаДетейИИмущественные,
					|РаспределениеРезультатовНачислений,
					|РаспределениеРезультатовУдержаний,
					|Удержания");
					
					//ДокументыРазовыхНачислений.СкопироватьИсправляемыйДокумент(ОтпускОбъект, 
					//								ДанныеЗаполнения.Ссылка, 
					//								"ДокументРассчитан,ДокументЗаполнения,Рассчитал", 
					//								"ДанныеОбИндексации,Начисления,НачисленияПерерасчет,НачисленияПерерасчетНулевыеСторно,
					//								|ОтпускаАвансомПерерасчет,НДФЛ,ОтработанноеВремяДляСреднегоОбщий,ПогашениеЗаймов,
					//								|Показатели,ПримененныеВычетыНаДетейИИмущественные,
					//								|РаспределениеРезультатовНачислений,РаспределениеРезультатовУдержаний,
					//								|СреднийЗаработокОбщий,Удержания");
				КонецЕсли;
				Если Не ЭтоРаботаВВыходныеДни Тогда
					ОтпускОбъект.ИсправленныйДокумент = ДанныеЗаполнения.Ссылка;					
				КонецЕсли;	
				//ОтпускОбъект.Организация = КонтекстЗагрузки.ОрганизацияСсылка;
				//ОтпускОбъект.Дата = ТекущаяДата(); //+КАБ КИриллова 30.06.2022   
				ОтпускОбъект.УстановитьНовыйНомер();
				ДанныеОтветственного = ПолучитьОтветственногоЗагрузкиДокументов(
					КонтекстЗагрузки.ТекстДляРегистрацииОшибки, КонтекстЗагрузки.ЕстьОшибкиУровняНеОжидание, ЕстьОшибкиПоДокументу);
				КонтекстЗагрузки.ТекстДляРегистрацииОшибки = ДанныеОтветственного.ТекстДляРегистрацииОшибки;
				КонтекстЗагрузки.ЕстьОшибкиУровняНеОжидание = ДанныеОтветственного.ЕстьОшибкиУровняНеОжидание;
				ЕстьОшибкиПоДокументу = ДанныеОтветственного.ЕстьОшибкиПоДокументу;
				Если ДанныеОтветственного.Успех Тогда
					ОтпускОбъект.Ответственный = ДанныеОтветственного.ПользовательОтветственный;
				Иначе
					Результат.Обработано = Истина;
					Возврат Результат;
				КонецЕсли;
				
				ОтпускОбъект.омУИД = ПолучитьСледующийУИД_ВСерии(ДокументДляЗагрузки,  ДокументИД);
				
			Иначе
				
				ОтпускОбъект = ДокументСсылка.ПолучитьОбъект();
				ОтпускОбъект.Дата = НачалоДня(ТекущаяДата()); //+КАБ КИриллова 30.06.2022    
				
			КонецЕсли; // проведен ли последний документ в цепочке изменений
			
		КонецЕсли; // проведен ли найденный документ
		//	КонецЕсли; //условие на продление
	КонецЕсли; // найден ли документ по ID	

	Результат.ОтпускОбъект = ОтпускОбъект;
	Возврат Результат;

КонецФункции

Процедура ДозаполнитьОтпускПоВидуДокумента(ОтпускОбъект, КонтекстДокумента, КонтекстЗагрузки, Исправление)

	ДокументДляЗагрузки = КонтекстДокумента.ДокументДляЗагрузки;
	ПериодРегистрации = КонтекстДокумента.ПериодРегистрации;
	ДатаПриказа = КонтекстДокумента.ДатаПриказа;
	ДатаНачалаОсновногоОтпуска = КонтекстДокумента.ДатаНачалаОсновногоОтпуска;
	ДатаОкончанияОсновногоОтпуска = КонтекстДокумента.ДатаОкончанияОсновногоОтпуска;
	ВидОтпускаИД = КонтекстДокумента.ВидОтпускаИД;
	МассивДнейУхода = КонтекстДокумента.МассивДнейУхода;
	МассивДополнительныеОтпуска = КонтекстДокумента.МассивДополнительныеОтпуска;
	МассивДатОтзыва = КонтекстДокумента.МассивДатОтзыва;
	МассивРаботаВВыходныеДни = КонтекстДокумента.МассивРаботаВВыходныеДни;
	ЭтоОтзыв = КонтекстДокумента.ЭтоОтзыв;
	ЭтоВозвратИзОУР = КонтекстДокумента.ЭтоВозвратИзОУР;
	ЭтоОтпускПоУходуЗаДетьмиИнвалидами = КонтекстДокумента.ЭтоОтпускПоУходуЗаДетьмиИнвалидами;
	ЭтоОтпускПоУходуЗаРебенком_15 = КонтекстДокумента.ЭтоОтпускПоУходуЗаРебенком_15;
	ЭтоОтпускПоУходуЗаРебенком_3 = КонтекстДокумента.ЭтоОтпускПоУходуЗаРебенком_3;
	ЭтоОплатаПоСреднемуЗаработку = КонтекстДокумента.ЭтоОплатаПоСреднемуЗаработку;
	ЭтоОтпускБезСохраненияОплаты = КонтекстДокумента.ЭтоОтпускБезСохраненияОплаты;
	ЭтоУченическийОтпуск = КонтекстДокумента.ЭтоУченическийОтпуск;
	ФизЛицоСсылка = КонтекстДокумента.ФизЛицоСсылка;
	СотрудникСсылка = КонтекстДокумента.СотрудникСсылка;
	ПроцентДляКомпенсацииНаСанаторноКурортноеЛечение = КонтекстДокумента.ПроцентДляКомпенсацииНаСанаторноКурортноеЛечение;
	Показатель = КонтекстДокумента.Показатель;
	МаксимальнаяСтоимостьСанаторноКурортнойПутевки = КонтекстДокумента.МаксимальнаяСтоимостьСанаторноКурортнойПутевки;
	ФормулаДляРасчета = КонтекстДокумента.ФормулаДляРасчета;
	ВидРасчетаСсылка = КонтекстДокумента.ВидРасчетаСсылка;
	СтруктураЗаполнения = КонтекстДокумента.СтруктураЗаполнения;
	ДокументИД = КонтекстДокумента.ДокументИД;
	НомерПриказа = КонтекстДокумента.НомерПриказа;
	БылПервыйДопОтп = КонтекстДокумента.БылПервыйДопОтп;

	Если ЭтоУченическийОтпуск Тогда
		ОтпускОбъект.УчитыватьМРОТПриОплатеПоСреднемуЗаработку = Истина;
	КонецЕсли;
	
	// специфическое дозаполнение по разным видам документов    
	Если ЭтоВозвратИзОУР Тогда   
		
		КонтекстЗагрузки.Запросы.ЗапросДокументОснованиеВозвратИзОУР.УстановитьПараметр("Период", ОтпускОбъект.ДатаВозврата);    
		КонтекстЗагрузки.Запросы.ЗапросДокументОснованиеВозвратИзОУР.УстановитьПараметр("Сотрудник", ОтпускОбъект.ОсновнойСотрудник);
		КонтекстЗагрузки.Запросы.ЗапросДокументОснованиеВозвратИзОУР.УстановитьПараметр("ФизическоеЛицо", ОтпускОбъект.Сотрудник); 
		ВыборкаЗапросДокументОснованиеВозвратИзОУР = КонтекстЗагрузки.Запросы.ЗапросДокументОснованиеВозвратИзОУР.Выполнить().Выбрать();
		Если ВыборкаЗапросДокументОснованиеВозвратИзОУР.Следующий() Тогда
			ОтпускОбъект.ДокументОснование = ВыборкаЗапросДокументОснованиеВозвратИзОУР.ОснованиеВозврата;
		КонецЕсли;
		
		ЗначенияДляЗаполнения = Новый Структура;
		ЗначенияДляЗаполнения.Вставить("Организация", ОтпускОбъект.Организация);
		ЗначенияДляЗаполнения.Вставить("Руководитель", Неопределено);
